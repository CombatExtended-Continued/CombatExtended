<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<CombatExtended.GasDef>
		<defName>CE_BlackSmoke</defName>
		<label>black smoke</label>
		<maxDensity>12800</maxDensity>
		<dissipationThreshold>30</dissipationThreshold>
		<minSpreadDensity>10</minSpreadDensity>
		<dissipationRate>0.00001</dissipationRate>
		<minDissipationPerTick>0.001</minDissipationPerTick>
		<outdoorLossPerInterval>60</outdoorLossPerInterval>
		<expireChancePerInterval>0.05</expireChancePerInterval>
		<fireDensityPerInterval>1800</fireDensityPerInterval>
		<ppmPerDensity>0.1</ppmPerDensity>
		<lethalDensity>10000</lethalDensity>
		<inhalationPerSecond>0.045</inhalationPerSecond>
