		<leaveFilth>true</leaveFilth>
		<filthDef>Filth_Ash</filthDef>
		<hediff>SmokeInhalation</hediff>
		<sensitivityStat>SmokeSensitivity</sensitivityStat>
		<notifyGasMask>true</notifyGasMask>
		<shader>CE_SmokeRotating</shader>
		<texPath>Things/Gas/Smoke</texPath>
		<color>(0,0,0,1)</color>
		<drawSize>3</drawSize>
		<rotationSpeed>50</rotationSpeed>
		<minDrawDensity>0</minDrawDensity>
	</CombatExtended.GasDef>
	
</Defs>
