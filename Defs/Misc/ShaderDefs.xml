<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Used by CombatExtended.GasLayer to draw gas. The GLSL lives in the mod's Shaders folder. -->
	<ShaderDef>
		<defName>CE_SmokeRotating</defName>
		<shaderProgram>
			<vertexShaderFileName>CE_SmokeRotating.vert.glsl</vertexShaderFileName>
			<fragmentShaderFileName>CE_SmokeRotating.frag.glsl</fragmentShaderFileName>
			<flipTextureST>false</flipTextureST>
			<transparent>true</transparent>
			<depthWrite>false</depthWrite>
			<renderQueue>3151</renderQueue>
			<textureWrapOverrides>
				<li>
					<key>_MainTex</key>
					<value>Clamp</value>
				</li>
			</textureWrapOverrides>
		</shaderProgram>
	</ShaderDef>

</Defs>
