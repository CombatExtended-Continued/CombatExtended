	<!-- EN: prometheum -->
	<Prometheum.label>prometheum</Prometheum.label>
	<!-- EN: Military-grade incendiary agent, ignites on contact with oxygen. The raw resource is used to craft incendiary ammo of all kinds. -->
	<Prometheum.description>Agente incendiario de grado militar que se enciende al contacto con el oxígeno. El recurso en bruto se usa para fabricar munición incendiaria de todo tipo.</Prometheum.description>

	<!-- EN: FSX -->
	<FSX.label>FSX</FSX.label>
	<!-- EN: High-explosive chemical extracted from Boomalope sacks and synthesized from chemfuel, it is used in a variety of industrial and military applications. -->
	<FSX.description>High-explosive chemical extracted from Boomalope sacks, it is used in a variety of industrial and military applications.</FSX.description>

