<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

	<!-- EN: Unload contents -->
	<CE_AutoLoader_DropAmmo>Descargar contenido</CE_AutoLoader_DropAmmo>
	<!-- EN: Unload this autoloader's contents onto the floor. -->
	<CE_AutoLoader_DropAmmoDesc>Descarga al suelo el contenido de este cargador automático.</CE_AutoLoader_DropAmmoDesc>

	<!-- EN: Reload turrets -->
	<CE_AutoLoader_ForceReload>Recargar torretas</CE_AutoLoader_ForceReload>
	<!-- EN: Reload adjacent turrets immediately. Forbidden turrets and currently firing turrets will be ignored. -->
	<CE_AutoLoader_ForceReloadDesc>Recarga de inmediato las torretas adyacentes. Se ignoran las torretas prohibidas y las que estén disparando.</CE_AutoLoader_ForceReloadDesc>

	<!-- EN: {0} needs to be manned by an operator to function. -->
	<CE_AutoLoader_Unmanned>{0} necesita un operador para funcionar.</CE_AutoLoader_Unmanned>
	<!-- EN: {0} needs power to function. -->
	<CE_AutoLoader_Unpowered>{0} necesita energía para funcionar.</CE_AutoLoader_Unpowered>
	<!-- EN: {0} cannot find any adjacent available {1} turrets. -->
	<CE_AutoLoader_NoTurretToReload>{0} no encuentra ninguna torreta adyacente disponible que use {1}.</CE_AutoLoader_NoTurretToReload>

	<!-- EN: Ammo replacement: on -->
	<CE_AutoLoader_ToggleReplaceOn>Sustitución de munición: activada</CE_AutoLoader_ToggleReplaceOn>
	<!-- EN: The autoloader will replace turret's current ammo with the ammo type in the loader. -->
	<CE_AutoLoader_ToggleReplaceDescOn>El cargador automático sustituirá la munición actual de la torreta por el tipo de munición que contiene.</CE_AutoLoader_ToggleReplaceDescOn>

	<!-- EN: Ammo replacement: off -->
	<CE_AutoLoader_ToggleReplaceOff>Sustitución de munición: desactivada</CE_AutoLoader_ToggleReplaceOff>
	<!-- EN: The autoloader will only reload turret with the same ammo type in the loader. -->
	<CE_AutoLoader_ToggleReplaceDescOff>El cargador automático solo recargará las torretas que usen el mismo tipo de munición que contiene.</CE_AutoLoader_ToggleReplaceDescOff>

	<!-- EN: Require manning to operate -->
	<CE_AutoLoader_ManningRequired>Requiere un operador para funcionar</CE_AutoLoader_ManningRequired>
	<!-- EN: Reload time remaining: {0} seconds -->
	<CE_AutoLoader_ReloadTime>Tiempo de recarga restante: {0} segundos</CE_AutoLoader_ReloadTime>
	<!-- EN: Ammo type replacement: {0} -->
	<CE_AutoLoader_ShouldReplace>Sustitución del tipo de munición: {0}</CE_AutoLoader_ShouldReplace>

	<!-- EN: Autoloader is reloading or being reloaded. -->
	<CE_AutoLoaderBusy>El cargador automático está recargando o siendo recargado.</CE_AutoLoaderBusy>

	<!-- EN: Select ammoset -->
	<CE_SelectAmmoSet>Seleccionar calibre</CE_SelectAmmoSet>
	<!-- EN: Select an ammoset to fill the autoloader. -->
	<CE_SelectAmmoSetDesc>Selecciona el calibre para llenar el cargador automático.</CE_SelectAmmoSetDesc>

</LanguageData>
