	<!-- EN: Plated automatic turret equiped with a high caliber machine gun. Very resistant to damage. -->
	<Turret_Heavy.description>Torreta automática blindada equipada con una ametralladora de gran calibre. Muy resistente al daño.</Turret_Heavy.description>

	<!-- M240B -->

