	<!-- Flak cannon -->

	<!-- EN: 90mm flak turret -->
	<Turret_Flak.label>torreta antiaérea de 90mm</Turret_Flak.label>
	<!-- EN: Old school anti-aircraft cannon. Ineffective against modern aviation but still popular on rimworlds for use against entrenched enemies and vehicles. -->
	<Turret_Flak.description>Cañón antiaéreo de la vieja escuela. Poco eficaz contra la aviación moderna, pero aún popular en los rimworlds para usarlo contra enemigos atrincherados y vehículos.</Turret_Flak.description>

	<!-- EN: medium auto-turret -->
	<Turret_Medium.label>torreta automática media</Turret_Medium.label>
	<!-- EN: Automatic turret equiped with a full powered cartridge machine gun. Fairly resistant to damage. -->
	<Turret_Medium.description>Torreta automática equipada con una ametralladora de cartucho de plena potencia. Bastante resistente al daño.</Turret_Medium.description>

