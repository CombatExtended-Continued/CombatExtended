	<CE_AutoLoader_ToggleReplaceDescOff>自动装载机只会为使用相同弹药类型的炮塔装填。</CE_AutoLoader_ToggleReplaceDescOff>

	<!-- EN: Require manning to operate -->
	<CE_AutoLoader_ManningRequired>需要人员操作</CE_AutoLoader_ManningRequired>
	<!-- EN: Reload time remaining: {0} seconds -->
	<CE_AutoLoader_ReloadTime>剩余装填时间：{0} 秒</CE_AutoLoader_ReloadTime>
	<!-- EN: Ammo type replacement: {0} -->
	<CE_AutoLoader_ShouldReplace>更换弹药类型：{0}</CE_AutoLoader_ShouldReplace>

	<!-- EN: Autoloader is reloading or being reloaded. -->
	<CE_AutoLoaderBusy>自动装载机正在装填炮塔或接受补充。</CE_AutoLoaderBusy>

	<!-- EN: Select ammoset -->
	<CE_SelectAmmoSet>选择弹药系列</CE_SelectAmmoSet>
