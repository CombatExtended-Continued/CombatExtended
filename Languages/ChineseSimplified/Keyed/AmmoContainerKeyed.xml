<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>

	<!-- EN: Unload contents -->
	<CE_AutoLoader_DropAmmo>卸下物品</CE_AutoLoader_DropAmmo>
	<!-- EN: Unload this autoloader's contents onto the floor. -->
	<CE_AutoLoader_DropAmmoDesc>将该自动装载机中的物品卸到地面上。</CE_AutoLoader_DropAmmoDesc>

	<!-- EN: Reload turrets -->
	<CE_AutoLoader_ForceReload>装填炮塔</CE_AutoLoader_ForceReload>
	<!-- EN: Reload adjacent turrets immediately. Forbidden turrets and currently firing turrets will be ignored. -->
	<CE_AutoLoader_ForceReloadDesc>立即装填相邻炮塔。已禁用或正在开火的炮塔将被忽略。</CE_AutoLoader_ForceReloadDesc>

	<!-- EN: {0} needs to be manned by an operator to function. -->
	<CE_AutoLoader_Unmanned>{0} 需要有人操作才能运行。</CE_AutoLoader_Unmanned>
	<!-- EN: {0} needs power to function. -->
	<CE_AutoLoader_Unpowered>{0} 需要电力才能运行。</CE_AutoLoader_Unpowered>
	<!-- EN: {0} cannot find any adjacent available {1} turrets. -->
	<CE_AutoLoader_NoTurretToReload>{0} 附近没有可装填 {1} 的炮塔。</CE_AutoLoader_NoTurretToReload>

	<!-- EN: Ammo replacement: on -->
	<CE_AutoLoader_ToggleReplaceOn>更换弹药：开启</CE_AutoLoader_ToggleReplaceOn>
	<!-- EN: The autoloader will replace turret's current ammo with the ammo type in the loader. -->
	<CE_AutoLoader_ToggleReplaceDescOn>自动装载机会用其中的弹药类型替换炮塔当前使用的弹药类型。</CE_AutoLoader_ToggleReplaceDescOn>

	<!-- EN: Ammo replacement: off -->
	<CE_AutoLoader_ToggleReplaceOff>更换弹药：关闭</CE_AutoLoader_ToggleReplaceOff>
