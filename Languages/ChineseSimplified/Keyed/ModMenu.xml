<LanguageData>

	<!-- ========== Headers ========== -->

	<!-- EN: General -->
	<CE_Settings_HeaderGeneral>常规</CE_Settings_HeaderGeneral>
	<!-- EN: Mechanics -->
	<CE_Settings_HeaderMechanics>机制</CE_Settings_HeaderMechanics>
	<!-- EN: Ammunition -->
	<CE_Settings_HeaderAmmo>弹药</CE_Settings_HeaderAmmo>
	<!-- EN: Graphic -->
	<CE_Settings_HeaderGraphic>图像</CE_Settings_HeaderGraphic>
	<!-- EN: Misc -->
	<CE_Settings_HeaderMisc>杂项</CE_Settings_HeaderMisc>
	<!-- EN: Autopatcher -->
	<CE_Settings_HeaderAutopatcher>自动补丁程序</CE_Settings_HeaderAutopatcher>

	<!-- ========== Sub Headers ========== -->

	<!-- EN: Rendering settings -->
	<CE_Settings_Rendering_Title>渲染设置</CE_Settings_Rendering_Title>
	<!-- EN: Experimental settings for apparel rendering -->
	<CE_Settings_Rendering_Desc>服装渲染的实验性设置</CE_Settings_Rendering_Desc>

	<!-- EN: Gameplay balance -->
	<CE_Settings_Value_Tweaks_Title>游戏平衡</CE_Settings_Value_Tweaks_Title>
	<!-- EN: Adjust various stats and multipliers affecting gameplay and combat balance. -->
	<CE_Settings_Value_Tweaks_Desc>调整影响游戏玩法与战斗平衡的各项属性和倍率。</CE_Settings_Value_Tweaks_Desc>

	<!-- ========== General settings ========== -->

	<!-- EN: Show shell casings -->
	<CE_Settings_ShowCasings_Title>显示抛壳</CE_Settings_ShowCasings_Title>
	<!-- EN: Firing weapons will display a dropped casing effect. -->
	<CE_Settings_ShowCasings_Desc>武器开火时会显示抛落的弹壳。</CE_Settings_ShowCasings_Desc>

	<!-- EN: Create shell casing filth -->
	<CE_Settings_CreateCasingsFilth_Title>产生弹壳污秽</CE_Settings_CreateCasingsFilth_Title>
	<!-- EN: Firing weapons will create cleanable filth of dropped casings. -->
	<CE_Settings_CreateCasingsFilth_Desc>武器开火时会产生可清理的弹壳污秽。</CE_Settings_CreateCasingsFilth_Desc>

	<!-- EN: Create impacted projectile flecks -->
	<CE_Settings_StuckArrowsAsFlecks_Title>生成投射物命中特效</CE_Settings_StuckArrowsAsFlecks_Title>
	<!-- EN: Certain projectiles, such as arrows, will create a temporary visual fleck on the ground where they impact. -->
	<CE_Settings_StuckArrowsAsFlecks_Desc>箭矢等部分投射物命中地面后会暂时留下视觉特效。</CE_Settings_StuckArrowsAsFlecks_Desc>

	<!-- EN: Show combat taunts -->
	<CE_Settings_ShowTaunts_Title>显示战斗嘲讽</CE_Settings_ShowTaunts_Title>
	<!-- EN: Pawns will display text-based taunts during combat. -->
	<CE_Settings_ShowTaunts_Desc>角色会在战斗中显示文字嘲讽。</CE_Settings_ShowTaunts_Desc>

	<!-- EN: Allow hunting with melee weapons -->
	<CE_Settings_AllowMeleeHunting_Title>允许近战狩猎</CE_Settings_AllowMeleeHunting_Title>
	<!-- EN: Hunters will still be allowed to hunt if they have a melee weapon equipped. -->
	<CE_Settings_AllowMeleeHunting_Desc>如果猎人装备了近战武器，他们仍然可以狩猎。</CE_Settings_AllowMeleeHunting_Desc>

	<!-- EN: Toggle black smoke system -->
	<CE_Settings_SmokeEffects_Title>启用黑烟系统</CE_Settings_SmokeEffects_Title>
	<!-- EN: Fire generates dangerous black smoke clouds, causing health complications to anyone not wearing protective gear. -->
	<CE_Settings_SmokeEffects_Desc>火灾会产生危险的黑烟云，使未穿戴防护装备的人出现健康问题。</CE_Settings_SmokeEffects_Desc>

	<!-- EN: Disable shield belts while manning turrets -->
	<CE_Settings_TurretsBreakShields_Title>操作炮塔时禁用护盾腰带</CE_Settings_TurretsBreakShields_Title>
	<!-- EN: When enabled, shield belts will deactivate while colonists are manning turrets. If disabled, shield belts will instead remain active, offering additional protection. -->
	<CE_Settings_TurretsBreakShields_Desc>启用后，殖民者操作炮塔时会停用护盾腰带。\n禁用后，护盾腰带会保持生效并提供额外保护。</CE_Settings_TurretsBreakShields_Desc>

	<!-- EN: Show backpacks -->
	<CE_Settings_ShowBackpacks_Title>显示背包</CE_Settings_ShowBackpacks_Title>
	<!-- EN: Enables / Disables the rendering of backpacks (all pawns) -->
	<CE_Settings_ShowBackpacks_Desc>启用或禁用所有角色的背包渲染。</CE_Settings_ShowBackpacks_Desc>

	<!-- EN: Show tactical vests -->
	<CE_Settings_ShowWebbing_Title>显示战术背心</CE_Settings_ShowWebbing_Title>
	<!-- EN: Enables / Disables the rendering of tactical vests (all pawns) -->
	<CE_Settings_ShowWebbing_Desc>启用或禁用所有角色的战术背心渲染。</CE_Settings_ShowWebbing_Desc>

	<!-- EN: Turn on partial armor -->
	<CE_Settings_PartialStats_Title>启用局部护甲属性</CE_Settings_PartialStats_Title>
	<!-- EN: When turned on some armor might have different stats on different body parts -->
	<CE_Settings_PartialStats_Desc>启用后，部分护甲可能对不同身体部位提供不同的属性值。</CE_Settings_PartialStats_Desc>

	<!-- EN: Show recoil animations -->
	<CE_Settings_RecoilAnim_Title>显示后坐力动画</CE_Settings_RecoilAnim_Title>
	<!-- EN: When enabled, ranged weapons and turrets will play recoil animations when they fire. -->
	<CE_Settings_RecoilAnim_Desc>启用后，远程武器和炮塔在开火时会播放后坐力动画。</CE_Settings_RecoilAnim_Desc>

	<!-- EN: Enable varied human height -->
	<CE_Settings_VariedHumanHeight_Title>启用不同的人类身高</CE_Settings_VariedHumanHeight_Title>
	<!-- EN: When enabled, certain humans, such as children or tall xenotypes, will have their height and width adjusted according to body size.\n\nThis can mean that small pawns might be unable to shoot over tall cover, and some tall pawns will be less protected by cover and easier to hit with ranged weapons.\n\nWhen disabled, all humans will be 1.75 m tall regardless of body size. -->
	<CE_Settings_VariedHumanHeight_Desc>启用后，儿童或高大异种人等部分人类角色的身高和宽度会根据体型调整。\n\n这可能导致体型较小的角色无法越过高大掩体射击，也可能使高大角色从掩体获得的保护更少，更容易被远程武器命中。\n\n禁用后，所有人类角色无论体型大小，身高均为 1.75 米。</CE_Settings_VariedHumanHeight_Desc>

	<!-- EN: Log unpatched tools -->
	<CE_Settings_LogUnpatchedDefs_Title>记录未适配工具</CE_Settings_LogUnpatchedDefs_Title>
	<!-- EN: When enabled, unpatched melee tools will be logged on startup.\n\nThis has no gameplay effect, but can be a useful utility for creating compatibility patches. -->
	<CE_Settings_LogUnpatchedDefs_Desc>启用后，启动时会记录未适配的近战工具。\n\n这不会影响游戏玩法，但可用于制作兼容性补丁。</CE_Settings_LogUnpatchedDefs_Desc>

	<!-- ========== Ammo settings ========== -->

	<!-- EN: Enable ammunition system -->
	<CE_Settings_EnableAmmoSystem_Title>启用弹药系统</CE_Settings_EnableAmmoSystem_Title>
	<!-- EN: Weapons require ammunition to reload and can use various specialized ammo types.\n\nWARNING: Changing this setting on an existing colony may cause bugs and instability, do so at your own risk. -->
	<CE_Settings_EnableAmmoSystem_Desc>武器需要弹药来重新装填，并且可以使用各种特殊弹药类型。\n\n警告：在现有的殖民地上更改此设置可能会导致错误和不稳定，请自行承担风险。</CE_Settings_EnableAmmoSystem_Desc>

	<!-- EN: Use generic ammo system -->
	<CE_Settings_GenericAmmo>使用通用弹药系统</CE_Settings_GenericAmmo>
	<!-- EN: Instead of using full caliber system use several generic calibers, while retaining ammo types and ammo system. (requires game reload) -->
	<CE_Settings_GenericAmmo_Desc>不使用完整口径体系，改用少数几种通用口径，同时保留弹药种类和弹药系统。（需要重新启动游戏）</CE_Settings_GenericAmmo_Desc>

	<!-- EN: Right-click ammo selection -->
	<CE_Settings_RightClickAmmoSelect_Title>右键弹药选择</CE_Settings_RightClickAmmoSelect_Title>
	<!-- EN: Right-clicking the reload button brings up the ammo selection menu. -->
	<CE_Settings_RightClickAmmoSelect_Desc>右击“重新装填”按钮，弹出弹药选择菜单。</CE_Settings_RightClickAmmoSelect_Desc>

	<!-- EN: Auto-reload on ammo select -->
	<CE_Settings_AutoReloadOnChangeAmmo_Title>切换目标弹药时自动重新装填</CE_Settings_AutoReloadOnChangeAmmo_Title>
	<!-- EN: Pawns will automatically reload when a new ammo type is selected. -->
	<CE_Settings_AutoReloadOnChangeAmmo_Desc>当选择新的弹药类型时，殖民者将自动重新装填。</CE_Settings_AutoReloadOnChangeAmmo_Desc>

	<!-- EN: Auto-equip ammo -->
	<CE_Settings_AutoTakeAmmo_Title>自动拾取弹药</CE_Settings_AutoTakeAmmo_Title>
	<!-- EN: Pawns without loadouts assigned will automatically pick up ammo for their equipped weapon. -->
	<CE_Settings_AutoTakeAmmo_Desc>未分配携带方针的角色会自动拾取所装备武器需要的弹药。</CE_Settings_AutoTakeAmmo_Desc>

	<!-- EN: Display weapon caliber -->
	<CE_Settings_ShowCaliberOnGuns_Title>显示武器口径</CE_Settings_ShowCaliberOnGuns_Title>
	<!-- EN: Ammunition-using weapons will have their caliber appended behind their name. -->
	<CE_Settings_ShowCaliberOnGuns_Desc>在使用弹药的武器名称后显示其口径。</CE_Settings_ShowCaliberOnGuns_Desc>

	<!-- EN: Re-use neolithic projectiles -->
	<CE_Settings_ReuseNeolithicProjectiles_Title>重复使用新石器时代投射物</CE_Settings_ReuseNeolithicProjectiles_Title>
	<!-- EN: Neolithic projectiles will have a chance to drop on the floor on impact. -->
	<CE_Settings_ReuseNeolithicProjectiles_Desc>新石器时代投射物命中后有概率掉落在地面上。</CE_Settings_ReuseNeolithicProjectiles_Desc>

	<!-- EN: Automatically forbid neolithic projectiles -->
	<CE_Settings_ForbiddenNeolithicProjectiles_Title>自动禁用新石器时代投射物</CE_Settings_ForbiddenNeolithicProjectiles_Title>
	<!-- EN: Spawned neolithic projectiles will be automatically forbidden. -->
	<CE_Settings_ForbiddenNeolithicProjectiles_Desc>生成的新石器时代投射物会被自动禁用。</CE_Settings_ForbiddenNeolithicProjectiles_Desc>

	<!-- EN: Realistic cook-off -->
	<CE_Settings_RealisticCookOff_Title>真实弹药殉爆</CE_Settings_RealisticCookOff_Title>
	<!-- EN: Ammunition stacks won't spawn damaging projectiles on cooking off. -->
	<CE_Settings_RealisticCookOff_Desc>弹药堆殉爆时不会生成具有杀伤力的投射物。</CE_Settings_RealisticCookOff_Desc>

	<!-- EN: Enables extra tooltips for the cell under the mouse pointer (hold left-shift to view). -->
	<CE_Settings_ShowExtraTooltips_Desc>显示鼠标指针所在地图格的额外提示（按住左 Shift 键查看）。</CE_Settings_ShowExtraTooltips_Desc>
	<!-- EN: Show extra tooltips -->
	<CE_Settings_ShowExtraTooltips_Title>显示额外提示</CE_Settings_ShowExtraTooltips_Title>

	<!-- EN: Enables extra (internal, redundant, or confusing) stats in some info cards. -->
	<CE_Settings_ShowExtraStats_Desc>在部分信息卡中显示额外属性（内部、重复或容易引起困惑的属性）。</CE_Settings_ShowExtraStats_Desc>
	<!-- EN: Show extra stats -->
	<CE_Settings_ShowExtraStats_Title>显示额外属性</CE_Settings_ShowExtraStats_Title>

	<!-- EN: Enables extra information about parry, dodge and other attack chance modifiers in melee tooltip. -->
	<CE_Settings_DetailedMeleeTooltip_Desc>在近战提示中显示招架、闪避及其他攻击概率修正的详细信息。</CE_Settings_DetailedMeleeTooltip_Desc>
	<!-- EN: Show detailed melee tooltip -->
	<CE_Settings_DetailedMeleeTooltip_Title>显示详细近战提示</CE_Settings_DetailedMeleeTooltip_Title>

	<!-- EN: Enables melee tooltip for all pawns, including wild animals, allies and raiders. -->
	<CE_Settings_NonPlayerMeleeTooltip_Desc>为所有角色启用近战提示，包括野生动物、盟友和袭击者。</CE_Settings_NonPlayerMeleeTooltip_Desc>
	<!-- EN: Show melee tooltip for all pawns -->
	<CE_Settings_NonPlayerMeleeTooltip_Title>为所有角色显示近战提示</CE_Settings_NonPlayerMeleeTooltip_Title>

	<!-- EN: If true, damaging walls can generate fragments -->
	<CE_Settings_FragmentsFromWalls_Desc>启用后，墙体受损时可能产生破片。</CE_Settings_FragmentsFromWalls_Desc>
	<!-- EN: Fragments from walls -->
	<CE_Settings_FragmentsFromWalls_Title>墙体破片</CE_Settings_FragmentsFromWalls_Title>

	<!-- EN: When enabled, some of the fragments from walls might be reflected back at the shooter. -->
	<CE_Settings_FragmentsFromWallsReflected_Desc>启用后，墙体产生的部分破片可能反弹向射手。</CE_Settings_FragmentsFromWallsReflected_Desc>
	<!-- EN: Reflected fragments from walls -->
	<CE_Settings_FragmentsFromWallsReflected_Title>墙体破片反弹</CE_Settings_FragmentsFromWallsReflected_Title>

	<!-- EN: Controls how many wall fragments will spawn and how big they will be. -->
	<CE_Settings_FragmentsFromWallsIntensity_Desc>控制墙体破片的生成数量和大小。</CE_Settings_FragmentsFromWallsIntensity_Desc>
	<!-- EN: Fragments from walls intensity -->
	<CE_Settings_FragmentsFromWallsIntensity_Title>墙体破片强度</CE_Settings_FragmentsFromWallsIntensity_Title>

	<!-- EN: If true, subsequent shots at the same, or nearby, targets are faster. -->
	<CE_Settings_FasterRepeatShots_Desc>启用后，对同一目标或附近目标的后续射击会更快。</CE_Settings_FasterRepeatShots_Desc>
	<!-- EN: Faster subsequent shots -->
	<CE_Settings_FasterRepeatShots_Title>加快后续射击</CE_Settings_FasterRepeatShots_Title>

	<!-- EN: When enabled, shooters will switch to a new target when their primary target is downed mid-burst. -->
	<CE_Settings_MidBurstRetarget_Desc>启用后，主要目标在连射途中倒地时，射手会切换到新目标。</CE_Settings_MidBurstRetarget_Desc>
	<!-- EN: Retarget mid burst -->
	<CE_Settings_MidBurstRetarget_Title>连射途中重新选定目标</CE_Settings_MidBurstRetarget_Title>

	<!-- EN: Show additional projectile visual effects -->
	<CE_Settings_EnableExtraEffects_Title>显示额外的投射物特效</CE_Settings_EnableExtraEffects_Title>
	<!-- EN: Bullets and other projectiles will display additional effects, such as bullets kicking up dust or incendiaries throwing sparks. Cosmetic only, does not affect gameplay. -->
	<CE_Settings_EnableExtraEffects_Desc>子弹和其他投射物会显示额外的特效，比如子弹扬起灰尘或燃烧弹喷出火花。只是特效，不影响游戏。</CE_Settings_EnableExtraEffects_Desc>

	<!-- EN: Suppressed pawns seek cover -->
	<CE_Settings_SuppressionCausesRunning_Title>受压制角色寻找掩体</CE_Settings_SuppressionCausesRunning_Title>
	<!-- EN: When enabled, pawns under light (yellow) suppression will interupt what they are doing to seek cover. Pawns under heavy (orange) suppression will still hunker. -->
	<CE_Settings_SuppressionCausesRunning_Desc>启用后，受到轻度（黄色）压制的角色会中断当前行动并寻找掩体；受到重度（橙色）压制的角色仍会卧倒。</CE_Settings_SuppressionCausesRunning_Desc>

	<!-- EN: Use real weapon names -->
	<CE_Settings_RealWeaponNames_Title>使用武器真实名称</CE_Settings_RealWeaponNames_Title>
	<!-- EN: When enabled, base game weapons, as well as some official add-on content, will use their real life names.\n\nRequires a restart to apply. -->
	<CE_Settings_RealWeaponNames_Desc>启用后，原版武器和部分官方扩展内容会使用其现实名称。\n\n需要重新启动游戏才能应用。</CE_Settings_RealWeaponNames_Desc>

	<!-- ========= Explosion Settings ========= -->

	<!-- EN: Explosion Settings -->
	<CE_Settings_ExplosionSettings>爆炸设置</CE_Settings_ExplosionSettings>

	<!-- EN: Merge explosions -->
	<CE_Settings_MergeExplosions_Title>合并爆炸</CE_Settings_MergeExplosions_Title>
	<!-- EN: Nearby explosions are merged into each other, significantly improving performance during a massive explosives cook-off. Strongly recommended to leave on. -->
	<CE_Settings_MergeExplosions_Desc>将邻近的爆炸相互合并，可显著改善大量爆炸物殉爆时的性能。强烈建议保持启用。</CE_Settings_MergeExplosions_Desc>

	<!-- EN: Explosion power multiplier -->
	<CE_Settings_ExplosionPenMultiplier_Title>爆炸威力倍率</CE_Settings_ExplosionPenMultiplier_Title>
	<!-- EN: Scales all explosion damage and penetration by this amount -->
	<CE_Settings_ExplosionPenMultiplier_Desc>按此数值缩放所有爆炸伤害和穿透力。</CE_Settings_ExplosionPenMultiplier_Desc>

	<!-- EN: Explosion falloff rate -->
	<CE_Settings_ExplosionDamageFalloffFactor_Title>爆炸衰减率</CE_Settings_ExplosionDamageFalloffFactor_Title>
	<!-- EN: Scales explosion falloff rates. The rate is applied to the distance from epicenter before other calculations -->
	<CE_Settings_ExplosionDamageFalloffFactor_Desc>缩放爆炸衰减速度；在进行其他计算前，此倍率会应用于距爆心的距离。</CE_Settings_ExplosionDamageFalloffFactor_Desc>

	<!-- ======== Stabilization settings ======== -->

	<!-- EN: Injury Stabilize Settings -->
	<CE_Settings_StabilizationSettings>伤势稳定设置</CE_Settings_StabilizationSettings>

	<!-- EN: Medicine search radius -->
	<CE_Settings_MedicineSearchRadius_Title>药品搜索半径</CE_Settings_MedicineSearchRadius_Title>
	<!-- EN: Sets the distance that medicine will be searched for to stabilize a pawn. -->
	<CE_Settings_MedicineSearchRadius_Desc>设置在为角色稳定伤势时搜索药品的距离。</CE_Settings_MedicineSearchRadius_Desc>

	<!-- ========== Bipod settings ========== -->

	<!-- EN: Bipod settings -->
	<CE_Settings_BipodSettings>脚架设置</CE_Settings_BipodSettings>

	<!-- EN: Use bipod mechanics -->
	<CE_Settings_BipodMechanics_Title>使用脚架机制</CE_Settings_BipodMechanics_Title>
	<!-- EN: Some weapons will be equipped with bipods, giving penalties when not set up and slight bonuses when set up. -->
	<CE_Settings_BipodMechanics_Desc>部分武器配有脚架，未架设时会受到惩罚，架设后则获得少量加成。</CE_Settings_BipodMechanics_Desc>

	<!-- EN: Toggle bipod autosetup -->
	<CE_Settings_BipodAutoSetUp_Title>自动使用脚架</CE_Settings_BipodAutoSetUp_Title>
	<!-- EN: Weapons with bipods will automatically start setting up when not set to snapshot. -->
	<CE_Settings_BipodAutoSetUp_Desc>配有脚架的武器未设为快速射击时会自动开始架设。</CE_Settings_BipodAutoSetUp_Desc>

	<!-- ========== Compatibility settings ========== -->

	<!-- EN: Vehicle settings -->
	<CE_Settings_Vehicles>载具设置</CE_Settings_Vehicles>

	<!-- EN: Use New Vehicle Armor -->
	<CE_Settings_PatchArmorDamage_Title>使用新型载具护甲</CE_Settings_PatchArmorDamage_Title>
	<!-- EN: Vehicle Armor reduces damage based on relative values, but can be penetrated by high AP attacks.. -->
	<CE_Settings_PatchArmorDamage_Desc>载具护甲会根据相对数值降低伤害，但仍可被高穿透攻击击穿。</CE_Settings_PatchArmorDamage_Desc>

	<!-- EN: Hit any component -->
	<CE_Settings_HitRandomVehicleComponents_Title>命中任意部件</CE_Settings_HitRandomVehicleComponents_Title>
	<!-- EN: When a vehicle is at low health, projectiles that fail to encounter a surviving component will instead damage a random one.\n\nThis prevents heavily damaged vehicles being kept intact by small, hard-to-hit components. -->
	<CE_Settings_HitRandomVehicleComponents_Desc>载具耐久较低时，未命中尚存部件的投射物会改为随机伤害一个部件。\n\n这样可以避免严重受损的载具仅因剩下小型、难以命中的部件而始终不被摧毁。</CE_Settings_HitRandomVehicleComponents_Desc>

	<!-- EN: Fragments from vehicles -->
	<CE_Settings_FragmentsFromVehicles_Title>载具破片</CE_Settings_FragmentsFromVehicles_Title>
	<!-- EN: When a projectile over-penetrates a vehicle, generate a fragments on the far side. -->
	<CE_Settings_FragmentsFromVehicles_Desc>投射物贯穿载具时，会在另一侧产生破片。</CE_Settings_FragmentsFromVehicles_Desc>

	<!-- ========== Autopatcher settings ========== -->

	<!-- EN: Enable autopatcher verbose logging -->
	<CE_Settings_VerboseAutopatcher_Title>启用自动补丁程序详细日志</CE_Settings_VerboseAutopatcher_Title>
	<!-- EN: This will enable verbose logging of the autopatcher -->
	<CE_Settings_VerboseAutopatcher_Desc>这将启用自动补丁程序的详细日志记录。</CE_Settings_VerboseAutopatcher_Desc>			

	<!-- EN: Enable apparel autopatcher -->
	<CE_Settings_ApparelAutopatcher_Title>启用服装自动补丁程序</CE_Settings_ApparelAutopatcher_Title>
	<!-- EN: Attempt to apply an appropriate apparel preset to the armor values of unpatched apparel. -->
	<CE_Settings_ApparelAutopatcher_Desc>尝试为未适配服装的护甲值应用合适的服装预设。</CE_Settings_ApparelAutopatcher_Desc>

	<!-- EN: Enable race autopatcher -->
	<CE_Settings_RaceAutopatcher_Title>启用种族自动补丁程序</CE_Settings_RaceAutopatcher_Title>
	<!-- EN: The autopatcher will apply a preset to unpatched races to allow basic functionality. -->
	<CE_Settings_RaceAutopatcher_Desc>自动补丁程序将为未打补丁的种族应用预设，以允许基本功能。</CE_Settings_RaceAutopatcher_Desc>

	<!-- EN: Enable weapon autopatcher -->
	<CE_Settings_WeaponAutopatcher_Title>启用武器自动补丁程序</CE_Settings_WeaponAutopatcher_Title>
	<!-- EN: Attempt to apply an appropriate weapon preset to unpatched ranged weapons. -->
	<CE_Settings_WeaponAutopatcher_Desc>尝试为未适配的远程武器应用合适的武器预设。</CE_Settings_WeaponAutopatcher_Desc>

	<!-- EN: Enable weapon toughness autopatcher -->
	<CE_Settings_ToughnessAutopatcher_Title>启用武器韧性自动补丁程序</CE_Settings_ToughnessAutopatcher_Title>
	<!-- EN: Apply an automatically calculated toughness stat to weapons, which affects how much damage they recieve when used in melee. -->
	<CE_Settings_ToughnessAutopatcher_Desc>为武器应用自动计算的韧性属性，该属性会影响在近战中使用时武器所受的伤害。</CE_Settings_ToughnessAutopatcher_Desc>

	<!-- EN: Enable pawnkind autopatcher -->
	<CE_Settings_PawnkindAutopatcher_Title>启用角色类型自动补丁程序</CE_Settings_PawnkindAutopatcher_Title>
	<!-- EN: Give unpatched pawnkinds equipped with a patched ranged weapon a small amount of ammunition. -->
