<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
	
	<!-- EN: fragmentation -->
	<RocketFrag.label>破片弹</RocketFrag.label>
	<!-- EN: Designed to explode into a cloud of deadly shrapnel, shredding soft targets in a large area. -->
	<RocketFrag.description>爆炸时会形成致命破片云，对大片区域内的软目标造成撕裂伤害。</RocketFrag.description>
	<!-- EN: Frag -->
	<RocketFrag.labelShort>破片弹</RocketFrag.labelShort>
	
	<!-- EN: High Explosive -->
	<RocketHE.label>高爆弹</RocketHE.label>
	<!-- EN: Designed to explode, damaging targets in a large area. -->
	<RocketHE.description>通过爆炸杀伤大片区域内的目标。</RocketHE.description>
	<!-- EN: HE -->
	<RocketHE.labelShort>高爆弹</RocketHE.labelShort>
	
	<!-- EN: high-explosive anti-tank -->
	<RocketHEAT.label>破甲弹</RocketHEAT.label>
	<!-- EN: Shaped charge warhead. Detonates on impact, creating a super-heated stream of molten metal that punches through enemy armor. -->
	<RocketHEAT.description>采用聚能装药弹头，命中时引爆并形成高温金属射流，以击穿敌方护甲。</RocketHEAT.description>
	<!-- EN: HEAT -->
	<RocketHEAT.labelShort>破甲弹</RocketHEAT.labelShort>
	
	<!-- EN: thermobaric -->
	<RocketThermobaric.label>温压弹</RocketThermobaric.label>
	<!-- EN: Disperses and subsequently ignites a fuel-air explosive mix, creating a powerful explosion and potentially igniting flammable objects. -->
	<RocketThermobaric.description>先散布燃料空气混合物，再将其点燃，造成强力爆炸并可能引燃易燃物。</RocketThermobaric.description>
	
</LanguageData>
