<LanguageData>

	<!-- EN: bunker buster -->
	<ChargedRocketBB.label>攻坚弹</ChargedRocketBB.label>
	<!-- EN: BB -->
	<ChargedRocketBB.labelShort>攻坚弹</ChargedRocketBB.labelShort>
	<!-- EN: A thermobaric payload designed to destroy fortifications and structures. -->
	<ChargedRocketBB.description>一种用于摧毁防御工事和建筑的温压弹荷。</ChargedRocketBB.description>

	<!-- EN: high-explosive charged -->
	<ChargedRocketHEC.label>高爆电荷弹</ChargedRocketHEC.label>
	<!-- EN: HE-C -->
	<ChargedRocketHEC.labelShort>高爆电荷弹</ChargedRocketHEC.labelShort>
