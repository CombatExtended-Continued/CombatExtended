<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
	
	<!-- EN: advanced ammunition -->
	<CE_AdvancedAmmo.label>先进弹药</CE_AdvancedAmmo.label>
	<!-- EN: Allows for the production of advanced ammunition for small arms and light weapons systems like armor-piercing incendiary, sabot, and high-explosive rounds. -->
	<CE_AdvancedAmmo.description>允许为轻武器系统生产穿甲燃烧弹、脱壳弹和高爆弹等先进弹药。</CE_AdvancedAmmo.description>
	<!-- EN:
		<li>subject->advanced ammunition</li>
		<li>subject->ammunition fillings</li>
		<li>subject_story->stumbled across a cache of advanced weapons</li>
		<li>subject_story->learned to use a discarding sabot to defeat powered armor</li>
		<li>subject_story->worked for a prolific arms dealer</li>
		<li>subject_story->studied the aftermath of a mechanoid assault</li>
		<li>subject_gerund->creating explosive ammunition</li>
		<li>subject_gerund->crafting discarding sabots</li>
	-->
	<CE_AdvancedAmmo.generalRules.rulesStrings>
		<li>subject->先进弹药</li>
		<li>subject->弹药填充物</li>
		<li>subject_story->偶然发现了一批先进武器的藏匿处</li>
		<li>subject_story->学会使用脱壳穿甲弹击败动力装甲</li>
		<li>subject_story->曾为一位高产的军火商工作</li>
		<li>subject_story->研究过机械族袭击后的战场</li>
		<li>subject_gerund->制造爆炸性弹药</li>
		<li>subject_gerund->制作脱壳穿甲弹</li>
	</CE_AdvancedAmmo.generalRules.rulesStrings>
	
	<!-- EN: advanced launchers -->
	<CE_AdvancedLaunchers.label>先进发射器</CE_AdvancedLaunchers.label>
	<!-- EN: Allows for the production of more advanced launchers and munitions such as incendiary, triple rocket, and doomsday launchers, as well as thermobaric and time-fuzed projectiles. -->
	<CE_AdvancedLaunchers.description>允许生产燃烧弹发射器、三重火箭发射器和末日火箭发射器等更先进的发射器与弹药，以及温压和定时引信投射物。</CE_AdvancedLaunchers.description>
	<!-- EN:
		<li>subject->fused explosives</li>
		<li>subject->advanced explosives</li>
		<li>subject_story->devastated fields with incendiary shells</li>
		<li>subject_story->optimized compact thermobaric cell construction</li>
		<li>subject_story->explored an enormous blast crater on a toxic world</li>
		<li>subject_gerund->crafting advanced launchers</li>
		<li>subject_gerund->crafting fuel cell launchers</li>
	-->
	<CE_AdvancedLaunchers.generalRules.rulesStrings>
		<li>subject->混合爆炸物</li>
		<li>subject->先进炸药</li>
		<li>subject_story->用燃烧弹摧毁了大片区域</li>
		<li>subject_story->优化了紧凑型温压弹单元的构造</li>
		<li>subject_story->在一个剧毒世界上探索了一个巨大的爆炸坑</li>
		<li>subject_gerund->制造高级发射器</li>
		<li>subject_gerund->制造燃料电池发射器</li>
	</CE_AdvancedLaunchers.generalRules.rulesStrings>
	
	<!-- EN: advanced optoelectronics -->
	<CE_AdvancedNV.label>先进光电子学</CE_AdvancedNV.label>
	<!-- EN: Allows for the production of more advanced and specialized electro-optical devices, including better night vision goggles and advanced digital optics. -->
	<CE_AdvancedNV.description>允许生产更先进、更专业的光电设备，包括性能更好的夜视镜和先进数字瞄具。</CE_AdvancedNV.description>
	<!-- EN:
		<li>subject->advanced optoelectronics</li>
		<li>subject_story->meticulously studied the sensors of destroyed mechanoids</li>
		<li>subject_story->uncovered an ancient cryosleep crypt containing stores of advanced armor</li>
		<li>subject_story->was trained as a scout in the military of an urbworld</li>
		<li>subject_story->worked in a military prototyping lab</li>
		<li>subject_gerund->crafting night vision sets</li>
		<li>subject_gerund->fabricating advanced optoelectronics</li>
	-->
	<CE_AdvancedNV.generalRules.rulesStrings>
		<li>subject->先进光电技术</li>
		<li>subject_story->仔细研究了被摧毁机械族的传感器</li>
		<li>subject_story->发现了藏有先进护甲的古老冷冻休眠墓穴</li>
		<li>subject_story->在一个都市世界的军队中受训成为侦察兵</li>
		<li>subject_story->曾在军用原型设备实验室工作</li>
		<li>subject_gerund->制作夜视设备</li>
		<li>subject_gerund->制造先进光电器件</li>
	</CE_AdvancedNV.generalRules.rulesStrings>
	
	<!-- EN: gunpowder -->
	<CE_Gunpowder.label>火药</CE_Gunpowder.label>
	<!-- EN: Craft early muzzle loading weapons and black powder ammunition. -->
	<CE_Gunpowder.description>制造早期前装火药武器和黑火药弹药。</CE_Gunpowder.description>
