<?xml version="1.0" encoding="UTF-8"?>
<Patch>

	<Operation Class="CombatExtended.PatchOperationSettingsConditional">
		<settingName>vanillaCombatPower</settingName>
		<match Class="PatchOperationReplace">
			<xpath>Defs/PawnKindDef[defName="CE_Tribal_Grenadier" or defName="CE_Tribal_Gunner"]/combatPower</xpath>
			<value>
				<combatPower>80</combatPower>
			</value>
		</match>
	</Operation>

</Patch>