<Project>
  <PropertyGroup>
   <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyVersion>15.6.3.1</AssemblyVersion>
	<FileVersion>15.6.3.1</FileVersion>
	<Version>15.6.3.1</Version>
	<Company />
	<Authors />
	<Copyright>CC BY-NC-SA 4.0 2025</Copyright>
    <LangVersion>14</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
		<Reference Include="Assembly-CSharp">
		  <HintPath>..\..\..\..\Assembly-CSharp.dll</HintPath>
          <Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
		  <HintPath>..\..\..\..\UnityStubs.dll</HintPath>
          <Private>false</Private>
		</Reference>
        <Reference Include="Waylith">
		  <HintPath>..\..\..\..\Waylith.dll</HintPath>
          <Private>false</Private>
		</Reference>
   </ItemGroup>

  <ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
	</ItemGroup>
</Project>