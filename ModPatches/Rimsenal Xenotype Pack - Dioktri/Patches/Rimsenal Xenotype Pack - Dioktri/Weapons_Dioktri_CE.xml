<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========== Spear Ability =========== -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/DamageDef[defName="TE_EnyoShockwaveDamage"]</xpath>
		<value>
			<li Class="CombatExtended.DamageDefExtensionCE">
				<isAmbientDamage>true</isAmbientDamage>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AbilityDef[defName="TE_EnyoShockwave"]/statBases/Ability_EffectRadius</xpath>
		<value>
			<Ability_EffectRadius>3</Ability_EffectRadius>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="TE_EnyoShockwaveProjectile"]/projectile/explosionRadius</xpath>
		<value>
			<explosionRadius>3</explosionRadius>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="TE_EnyoShockwaveProjectile"]/projectile/speed</xpath>
		<value>
			<speed>80</speed>
		</value>
	</Operation>

	<!-- ========== Spear itself =========== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="TE_Enyo"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>shaft</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>10</power>
					<cooldownTime>0.85</cooldownTime>
					<chanceFactor>0.15</chanceFactor>
					<armorPenetrationBlunt>3.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Shaft</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>shaft</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>6</power>
					<cooldownTime>1.3</cooldownTime>
					<chanceFactor>0.05</chanceFactor>
					<armorPenetrationBlunt>2.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>head</label>
					<capacities>
						<li>Stab</li>
					</capacities>
					<power>26</power>
					<cooldownTime>1.2</cooldownTime>
					<armorPenetrationBlunt>4</armorPenetrationBlunt>
					<armorPenetrationSharp>22</armorPenetrationSharp>
					<linkedBodyPartsGroup>Head</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>head</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>45</power>
					<cooldownTime>2</cooldownTime>
					<armorPenetrationBlunt>2</armorPenetrationBlunt>
					<armorPenetrationSharp>15</armorPenetrationSharp>
					<linkedBodyPartsGroup>Head</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="TE_Enyo"]/statBases</xpath>
		<value>
			<Bulk>10</Bulk>
			<MeleeCounterParryBonus>1.68</MeleeCounterParryBonus>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="TE_Enyo"]</xpath>
		<value>
			<equippedStatOffsets>
				<MeleeCritChance>0.17</MeleeCritChance>
				<MeleeParryChance>1.45</MeleeParryChance>
				<MeleeDodgeChance>0.9</MeleeDodgeChance>
			</equippedStatOffsets>
		</value>
	</Operation>

</Patch>