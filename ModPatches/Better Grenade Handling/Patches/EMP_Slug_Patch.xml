<?xml version="1.0" encoding="utf-8"?>

<Patch>

    <!-- === 10 Gauge === -->
<Operation Class="PatchOperationRemove">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/damageDef</xpath>
</Operation>

<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/damageAmountBase</xpath>
  <value>
    <damageAmountBase>17</damageAmountBase>
  </value>
</Operation>

<Operation Class="PatchOperationAdd">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile</xpath>
  <value>
    <secondaryDamage>
				<li>
					<def>EMP</def>
					<amount>19</amount>
				</li>
    </secondaryDamage>
  </value>
</Operation>

<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/armorPenetrationSharp</xpath>
  <value>
    <armorPenetrationSharp>4</armorPenetrationSharp>
  </value>
</Operation>

<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/armorPenetrationBlunt</xpath>
  <value>
    <armorPenetrationBlunt>64.5</armorPenetrationBlunt>
  </value>
</Operation>

<Operation Class="PatchOperationAdd">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile</xpath>
  <value>
    <recoilMultiplier>1.33</recoilMultiplier>
  </value>
</Operation>

    
