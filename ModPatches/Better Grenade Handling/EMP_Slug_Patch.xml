<?xml version="1.0" encoding="utf-8"?>

<Defs>

<!-- === 
	Better Grenade Handling makes EMP shotgun slugs unable for Pawns to 
    fire them at humans and other organic creatures. This patch is created to add 
    a physical, yet negligible damage, to EMP slugs which does solve the issue.
    Per HomerN2763's own estimate, EMP slugs now have 1/2 the base damage and 
    the blunt penetration, and no effective range multiplier compared to normal Slugs,
    as well as having the same sharp penetration to Buckshots of each caliber. However,
    the recoil, EMP damage and shield belt penereation chance is kept the same,
    with EMP damage migrated to become secondary damage.
	=== -->


    <!-- === 10 Gauge === -->

<!-- === Remove EMP as Primary damage type === -->
<Operation Class="PatchOperationRemove">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/damageDef</xpath>
</Operation>

<!-- === Change Base Damage === -->
<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/damageAmountBase</xpath>
  <value>
    <damageAmountBase>17</damageAmountBase>
  </value>
</Operation>

<!-- === Insert EMP damage as Secondary damage === -->
<Operation Class="PatchOperationInsert">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/armorPenetrationSharp</xpath>
  <value>
    <secondaryDamage>
				<li>
					<def>EMP</def>
					<amount>19</amount>
				</li>
    <secondaryDamage>
  </value>
</Operation>

<!-- === Change Sharp Penetration === -->
<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/armorPenetrationSharp</xpath>
  <value>
    <armorPenetrationSharp>4</armorPenetrationSharp>
  </value>
</Operation>

<!-- === Change Blunt Penetration === -->
<Operation Class="PatchOperationReplace">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/armorPenetrationBlunt</xpath>
  <value>
    <armorPenetrationBlunt>64.5</armorPenetrationBlunt>
  </value>
</Operation>

<!-- === Add recoil multiplier === -->
<Operation Class="PatchOperationInsert">
  <xpath>Defs/ThingDef[defName="Bullet_10Gauge_ElectroSlug"]/projectile/casingMoteDefname</xpath>
  <value>
    <recoilMultiplier>1.33</recoilMultiplier>
  </value>
</Operation>

