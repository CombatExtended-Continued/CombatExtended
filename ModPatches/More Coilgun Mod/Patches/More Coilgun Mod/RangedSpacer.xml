	<Operation Class="PatchOperationRemove">
		<xpath>
			Defs/ThingDef[defName="Aqued_Gun_GaussCarbine"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussSlugger"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussDMR"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussSAW"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"]
		</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>
			Defs/ThingDef[defName="Aqued_Gun_GaussCarbine"]/verbs/li[label="low power shot"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussSlugger"]/verbs/li[label="low power shot"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussDMR"]/verbs/li[label="low power shot"] |
			Defs/ThingDef[defName="Aqued_Gun_GaussSAW"]/verbs/li[label="low power shot"]
		</xpath>
	</Operation>

	<!-- === Gauss Carbine === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Aqued_Gun_GaussCarbine</defName>
		<statBases>
			<Mass>3.9</Mass>
			<Bulk>4.0</Bulk>
			<SwayFactor>1.15</SwayFactor>
			<ShotSpread>0.10</ShotSpread>
			<SightsEfficiency>1</SightsEfficiency>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.09</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<defaultProjectile>Bullet_CoilGun_Rifle</defaultProjectile>
			<warmupTime>1.75</warmupTime>
			<range>45</range>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
			<soundCast>VWE_Shot_GaussRifle</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>4</reloadTime>
			<ammoSet>AmmoSet_6mmRailgun_GaussRifle</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
			<aiUseBurstMode>True</aiUseBurstMode>
			<aimedBurstShotCount>3</aimedBurstShotCount>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AR</li>
		</weaponTags>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Aqued_Gun_GaussCarbine"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_UnderBarrel">
				<standardLabel>switch to standard mode</standardLabel>
				<underBarrelLabel>switch to high-power mode</underBarrelLabel>
				<oneAmmoHolder>True</oneAmmoHolder>
				<propsUnderBarrel>
					<magazineSize>30</magazineSize>
					<reloadTime>4</reloadTime>
					<ammoSet>AmmoSet_6mmRailgun_GaussRifle_HP</ammoSet>
				</propsUnderBarrel>
				<verbPropsUnderBarrel>
					<recoilAmount>2.09</recoilAmount>
					<verbClass>CombatExtended.Verb_ShootCE</verbClass>
					<hasStandardCommand>True</hasStandardCommand>
					<defaultProjectile>Bullet_CoilGun_Rifle_HP</defaultProjectile>
					<warmupEffecter>VWE_Warmup_Effect</warmupEffecter>
					<warmupTime>2.75</warmupTime>
					<range>45</range>
					<burstShotCount>6</burstShotCount>
					<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
					<soundCast>VWE_Shot_GaussRifle</soundCast>
					<soundCastTail>GunTail_Medium</soundCastTail>
					<muzzleFlashScale>9</muzzleFlashScale>
				</verbPropsUnderBarrel>
				<propsFireModesUnderBarrel>
					<aiAimMode>AimedShot</aiAimMode>
					<aiUseBurstMode>True</aiUseBurstMode>
					<aimedBurstShotCount>3</aimedBurstShotCount>
				</propsFireModesUnderBarrel>
			</li>
		</value>
	</Operation>
	
