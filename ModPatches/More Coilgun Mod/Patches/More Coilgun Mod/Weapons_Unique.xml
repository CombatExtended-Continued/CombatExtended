<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Odyssey</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<li Class="PatchOperationRemove">
					<xpath>
						Defs/ThingDef[defName="Aqued_Gun_GaussSlugger_Unique"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
						Defs/ThingDef[defName="Aqued_Gun_GaussCarbine_Unique"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
						Defs/ThingDef[defName="Aqued_Gun_GaussSAW_Unique"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"] |
						Defs/ThingDef[defName="Aqued_Gun_GaussDMR_Unique"]/comps/li[@Class="VEF.Weapons.CompProperties_MultiVerbWeapon"]
					</xpath>
				</li>

				<!-- Unique Gauss slugger -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Aqued_Gun_GaussSlugger_Unique"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>8</magazineSize>
							<reloadTime>4.6</reloadTime>
							<ammoSet>AmmoSet_Railgun_12gauge_HP</ammoSet>
						</li>
						<li Class="CombatExtended.CompProperties_FireModes">
							<aiAimMode>AimedShot</aiAimMode>
							<aiUseBurstMode>True</aiUseBurstMode>
							<aimedBurstShotCount>1</aimedBurstShotCount>
						</li>
						<li Class="CombatExtended.CompProperties_UnderBarrel">
							<standardLabel>switch to standard mode</standardLabel>
							<underBarrelLabel>switch to high-power mode</underBarrelLabel>
							<oneAmmoHolder>True</oneAmmoHolder>
							<propsUnderBarrel>
								<magazineSize>8</magazineSize>
								<reloadTime>4.6</reloadTime>
								<ammoSet>AmmoSet_Railgun_12gauge_HP</ammoSet>
							</propsUnderBarrel>
							<verbPropsUnderBarrel>
								<recoilAmount>2.09</recoilAmount>
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>True</hasStandardCommand>
								<defaultProjectile>Bullet_CoilGun_12gauge_Slug_HP</defaultProjectile>
								<warmupEffecter>VWE_Warmup_Effect</warmupEffecter>
								<warmupTime>0.8</warmupTime>
								<range>18.9</range>
								<burstShotCount>1</burstShotCount>
								<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
								<soundCast>VWE_Shot_GaussLance</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
							</verbPropsUnderBarrel>
							<propsFireModesUnderBarrel>
								<aiAimMode>AimedShot</aiAimMode>
								<aiUseBurstMode>True</aiUseBurstMode>
								<aimedBurstShotCount>1</aimedBurstShotCount>
							</propsFireModesUnderBarrel>
						</li>
					</value>
				</li>

				<!-- Unique Gauss Carbine -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Aqued_Gun_GaussCarbine_Unique"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>30</magazineSize>
							<reloadTime>4</reloadTime>
							<ammoSet>AmmoSet_6mmRailgun_GaussRifle</ammoSet>
						</li>
						<li Class="CombatExtended.CompProperties_FireModes">
							<aiAimMode>AimedShot</aiAimMode>
							<aiUseBurstMode>True</aiUseBurstMode>
							<aimedBurstShotCount>4</aimedBurstShotCount>
						</li>
						<li Class="CombatExtended.CompProperties_UnderBarrel">
							<standardLabel>switch to standard mode</standardLabel>
							<underBarrelLabel>switch to high-power mode</underBarrelLabel>
							<oneAmmoHolder>True</oneAmmoHolder>
							<propsUnderBarrel>
								<magazineSize>30</magazineSize>
								<reloadTime>4</reloadTime>
								<ammoSet>AmmoSet_6mmRailgun_GaussRifle_HP</ammoSet>
							</propsUnderBarrel>
							<verbPropsUnderBarrel>
								<recoilAmount>2.09</recoilAmount>
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>True</hasStandardCommand>
								<defaultProjectile>Bullet_CoilGun_Rifle_HP</defaultProjectile>
								<warmupEffecter>VWE_Warmup_Effect</warmupEffecter>
								<warmupTime>1.1</warmupTime>
								<range>45</range>
								<burstShotCount>4</burstShotCount>
								<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
								<soundCast>VWE_Shot_GaussRifle</soundCast>
								<soundCastTail>GunTail_Medium</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
							</verbPropsUnderBarrel>
							<propsFireModesUnderBarrel>
								<aiAimMode>AimedShot</aiAimMode>
								<aiUseBurstMode>True</aiUseBurstMode>
								<aimedBurstShotCount>4</aimedBurstShotCount>
							</propsFireModesUnderBarrel>
						</li>
					</value>
				</li>
				
				<!-- Unique Gauss SAW -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Aqued_Gun_GaussSAW_Unique"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>90</magazineSize>
							<reloadTime>7.8</reloadTime>
							<ammoSet>AmmoSet_6mmRailgun_GaussRifle</ammoSet>
						</li>
						<li Class="CombatExtended.CompProperties_FireModes">
							<aiAimMode>AimedShot</aiAimMode>
							<aiUseBurstMode>True</aiUseBurstMode>
							<aimedBurstShotCount>10</aimedBurstShotCount>
						</li>
						<li Class="CombatExtended.CompProperties_UnderBarrel">
							<standardLabel>switch to standard mode</standardLabel>
							<underBarrelLabel>switch to high-power mode</underBarrelLabel>
							<oneAmmoHolder>True</oneAmmoHolder>
							<propsUnderBarrel>
								<magazineSize>100</magazineSize>
								<reloadTime>7.8</reloadTime>
								<ammoSet>AmmoSet_6mmRailgun_GaussRifle_HP</ammoSet>
							</propsUnderBarrel>
							<verbPropsUnderBarrel>
								<recoilAmount>2.09</recoilAmount>
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>True</hasStandardCommand>
								<defaultProjectile>Bullet_CoilGun_Rifle_HP</defaultProjectile>
								<warmupEffecter>VWE_Warmup_Effect</warmupEffecter>
								<warmupTime>4</warmupTime>
								<range>65</range>
								<burstShotCount>9</burstShotCount>
								<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
								<soundCast>VWE_Shot_GaussRifle</soundCast>
								<soundCastTail>GunTail_Medium</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
							</verbPropsUnderBarrel>
							<propsFireModesUnderBarrel>
								<aiAimMode>AimedShot</aiAimMode>
								<aiUseBurstMode>True</aiUseBurstMode>
								<aimedBurstShotCount>9</aimedBurstShotCount>
							</propsFireModesUnderBarrel>
						</li>
					</value>
				</li>

				<!-- Unique Gauss DMR -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="Aqued_Gun_GaussDMR_Unique"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_AmmoUser">
							<magazineSize>5</magazineSize>
							<reloadTime>4</reloadTime>
							<ammoSet>AmmoSet_6mmRailgun_GaussRifle</ammoSet>
						</li>
						<li Class="CombatExtended.CompProperties_FireModes">
							<aiAimMode>AimedShot</aiAimMode>
						</li>
						<li Class="CombatExtended.CompProperties_UnderBarrel">
							<standardLabel>switch to standard mode</standardLabel>
							<underBarrelLabel>switch to high-power mode</underBarrelLabel>
							<oneAmmoHolder>True</oneAmmoHolder>
							<propsUnderBarrel>
								<magazineSize>5</magazineSize>
								<reloadTime>4</reloadTime>
								<ammoSet>AmmoSet_6mmRailgun_GaussRifle_HP</ammoSet>
							</propsUnderBarrel>
							<verbPropsUnderBarrel>
								<recoilAmount>2.0</recoilAmount>
								<verbClass>CombatExtended.Verb_ShootCE</verbClass>
								<hasStandardCommand>True</hasStandardCommand>
								<defaultProjectile>Bullet_CoilGun_Rifle_HP</defaultProjectile>
								<warmupEffecter>VWE_Warmup_Effect</warmupEffecter>								
								<warmupTime>1.8</warmupTime>
								<range>75</range>
								<soundCast>VWE_Shot_GaussRifle</soundCast>
								<soundCastTail>GunTail_Heavy</soundCastTail>
								<muzzleFlashScale>9</muzzleFlashScale>
								<recoilPattern>Regular</recoilPattern>
							</verbPropsUnderBarrel>
							<propsFireModesUnderBarrel>
								<aiAimMode>AimedShot</aiAimMode>
							</propsFireModesUnderBarrel>
						</li>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>