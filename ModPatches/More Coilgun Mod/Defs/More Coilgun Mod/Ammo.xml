<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo12gaugeRailgun</defName>
		<label>Railshot Ammo</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRailgunRifle</iconPath>
	</ThingCategoryDef>

	<!-- === Coilguns do less damage than some conventional rounds, but have far superior penetration, making them superior against thick armor. === -->

	<!-- === Ammo Sets === -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_Railgun_12gauge</defName>
		<label>Railshot</label>
		<ammoTypes>
			<Ammo_Railgun_12gauge_Slug>Bullet_CoilGun_12gauge_Slug</Ammo_Railgun_12gauge_Slug>
			<Ammo_Railgun_12gauge_Shard>Bullet_CoilGun_12gauge_Shard</Ammo_Railgun_12gauge_Shard>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_Railgun_12gauge_HP</defName>
		<label>Railshot (high power)</label>
		<ammoTypes>
			<Ammo_Railgun_12gauge_Slug>Bullet_CoilGun_12gauge_Slug_HP</Ammo_Railgun_12gauge_Slug>
			<Ammo_Railgun_12gauge_Shard>Bullet_CoilGun_12gauge_Shard_HP</Ammo_Railgun_12gauge_Shard>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
		<defName>Ammo_Railgun_12gauge_Slug</defName>
		<label>Railshot (Slug)</label>
		<description>slug, designed for railgun shotguns.</description>
		<statBases>
			<Mass>0.01</Mass>
			<Bulk>0.008</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<!-- Railgun ammo isn't handloaded because it contains no propellant, and the sabots must be precision-machined anyway -->
		</tradeTags>
		<thingCategories>
			<li>Ammo12gaugeRailgun</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Rifle</texPath>
			<graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
		</graphicData>
		<ammoClass>RailgunSabot</ammoClass>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="SpacerSmallAmmoBase">
		<defName>Ammo_Railgun_12gauge_Shard</defName>
		<label>Railshot (Shard)</label>
		<description>fragmentation shot, designed for railgun shotguns.</description>
		<statBases>
			<Mass>0.01</Mass>
			<Bulk>0.008</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting_FabricationBench</li>
			<li>CE_AutoEnableCrafting_TableMachining</li>
			<!-- Railgun ammo isn't handloaded because it contains no propellant, and the sabots must be precision-machined anyway -->
		</tradeTags>
		<thingCategories>
			<li>Ammo12gaugeRailgun</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Ammo/Railgun/Rifle</texPath>
			<graphicClass>CombatExtended.Graphic_StackCountRanged</graphicClass>
		</graphicData>
		<ammoClass>BuckShot</ammoClass>
	</ThingDef>

	<!-- === Projectiles === -->

	<ThingDef Class="CombatExtended.Lasers.LaserBeamDefCE" ParentName="LaserBulletYellow">
		<defName>Bullet_CoilGun_12gauge_Slug</defName>
		<label>Railshot Slug</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<isInstant>true</isInstant>
			<damageFalloff>False</damageFalloff>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>27</damageAmountBase>
			<armorPenetrationSharp>69.6</armorPenetrationSharp>
			<armorPenetrationBlunt>312</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.Lasers.LaserBeamDefCE" ParentName="LaserBulletYellow">
		<defName>Bullet_CoilGun_12gauge_Shard</defName>
		<label>Railshot Shard</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<isInstant>true</isInstant>
			<damageFalloff>False</damageFalloff>
			<damageDef>Bullet</damageDef>
			<pelletCount>9</pelletCount>
			<spreadMult>8.9</spreadMult>
			<damageAmountBase>12</damageAmountBase>
			<armorPenetrationSharp>23</armorPenetrationSharp>
			<armorPenetrationBlunt>142.5</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<!-- === Highpower ratio the x 0.65 damage and 1.5 sharp pen === -->

	<ThingDef Class="CombatExtended.Lasers.LaserBeamDefCE" ParentName="LaserBulletYellow">
		<defName>Bullet_CoilGun_12gauge_Slug_HP</defName>
		<label>high-power railshot</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<isInstant>true</isInstant>
			<damageFalloff>False</damageFalloff>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>17</damageAmountBase>
			<armorPenetrationSharp>104</armorPenetrationSharp>
			<armorPenetrationBlunt>312</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.Lasers.LaserBeamDefCE" ParentName="LaserBulletYellow">
		<defName>Bullet_CoilGun_12gauge_Shard_HP</defName>
		<label>high-power railshot Shards</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<isInstant>true</isInstant>
			<damageFalloff>False</damageFalloff>
			<damageDef>Bullet</damageDef>
			<pelletCount>9</pelletCount>
			<spreadMult>8.9</spreadMult>
			<damageAmountBase>8</damageAmountBase>
			<armorPenetrationSharp>34.5</armorPenetrationSharp>
			<armorPenetrationBlunt>142.5</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_Railgun_12gauge_Slug</defName>
		<label>make Railshot (Slug) cartridge x250</label>
		<description>Craft 250 Railshot (Slug) cartridges.</description>
		<jobString>Making Railshot (Slug) cartridges.</jobString>
		<workAmount>1000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Uranium</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Railgun_12gauge_Slug>250</Ammo_Railgun_12gauge_Slug>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_Railgun_12gauge_Shard</defName>
		<label>make Railshot (Shard) cartridge x250</label>
		<description>Craft 250 12gauge Railshot (Shard) cartridges.</description>
		<jobString>Making 12gauge Railshot (Shard) cartridges.</jobString>
		<workAmount>1000</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Uranium</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Uranium</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Railgun_12gauge_Shard>250</Ammo_Railgun_12gauge_Shard>
		</products>
	</RecipeDef>

</Defs>