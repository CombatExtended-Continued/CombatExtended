<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========== AP_MetalStorm ========== -->
	<!-- Uses the vanilla Metalhorror body, which CE core already patches for natural armor. -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]</xpath>
		<value>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Humanoid</bodyShape>
				<canParry>true</canParry>
				<maxParry>5</maxParry>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases</xpath>
		<value>
			<MeleeDodgeChance>0.05</MeleeDodgeChance>
			<MeleeCritChance>0.20</MeleeCritChance>
			<MeleeParryChance>0.25</MeleeParryChance>
			<PainShockThreshold>0.95</PainShockThreshold>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>22</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>48</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_ArmorDurability">
				<Durability>4500</Durability>
				<Regenerates>true</Regenerates>
				<RegenInterval>600</RegenInterval>
				<RegenValue>35</RegenValue>
				<MinArmorPct>0.5</MinArmorPct>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="AP_MetalStorm"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>left blade</label>
					<labelNoLocation>blade</labelNoLocation>
					<capacities>
						<li>Cut</li>
						<li>AP_Damage_Teleport</li>
					</capacities>
					<power>32</power>
					<cooldownTime>2.5</cooldownTime>
					<linkedBodyPartsGroup>LeftBlade</linkedBodyPartsGroup>
					<armorPenetrationSharp>3</armorPenetrationSharp>
					<armorPenetrationBlunt>8</armorPenetrationBlunt>
					<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>left blade</label>
					<labelNoLocation>blade</labelNoLocation>
					<capacities>
						<li>Stab</li>
						<li>AP_Damage_Teleport</li>
					</capacities>
					<power>18</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>LeftBlade</linkedBodyPartsGroup>
					<armorPenetrationSharp>30</armorPenetrationSharp>
					<armorPenetrationBlunt>15</armorPenetrationBlunt>
					<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>right blade</label>
					<labelNoLocation>blade</labelNoLocation>
					<capacities>
						<li>Cut</li>
						<li>AP_Damage_Teleport</li>
					</capacities>
					<power>32</power>
					<cooldownTime>2.5</cooldownTime>
					<linkedBodyPartsGroup>RightBlade</linkedBodyPartsGroup>
					<armorPenetrationSharp>3</armorPenetrationSharp>
					<armorPenetrationBlunt>8</armorPenetrationBlunt>
					<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>right blade</label>
					<labelNoLocation>blade</labelNoLocation>
					<capacities>
						<li>Stab</li>
						<li>AP_Damage_Teleport</li>
					</capacities>
					<power>18</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>RightBlade</linkedBodyPartsGroup>
					<armorPenetrationSharp>30</armorPenetrationSharp>
					<armorPenetrationBlunt>15</armorPenetrationBlunt>
					<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>head</label>
					<capacities>
						<li>Blunt</li>
						<li>AP_Damage_Teleport</li>
					</capacities>
					<power>9</power>
					<cooldownTime>5.9</cooldownTime>
					<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
					<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
					<chanceFactor>0.2</chanceFactor>
					<armorPenetrationBlunt>3</armorPenetrationBlunt>
				</li>
			</tools>
		</value>
	</Operation>

</Patch>
