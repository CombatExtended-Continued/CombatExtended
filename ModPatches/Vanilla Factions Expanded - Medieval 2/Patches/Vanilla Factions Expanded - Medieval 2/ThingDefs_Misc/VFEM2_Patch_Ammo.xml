<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Medieval Overhaul</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

			<!-- Add iron arrow to ammoset. -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_VFEM2WarArrow"]/ammoTypes</xpath>
				<value>
					<Ammo_GreatArrow_Iron>Projectile_VFEM2WarArrow_Iron</Ammo_GreatArrow_Iron>
				</value>
			</li>

			</operations>
		</match>
	</Operation>

</Patch>