<Patch>
  <!--Replace only the combat verb. Dryad.GauranlenTurret still selects its original sap verb for fires.-->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Dryad_Thorncaster_Gun']/verbs/li[defaultProjectile='Dryad_GauBullet']</xpath>
    <value>
      <li Class="CombatExtended.VerbPropertiesCE">
        <verbClass>CombatExtended.Verb_DryadTurretCE</verbClass>
        <defaultProjectile>Dryad_GauBullet</defaultProjectile>
        <warmupTime>0</warmupTime>
        <ticksBetweenBurstShots>35</ticksBetweenBurstShots>
        <burstShotCount>2</burstShotCount>
        <range>28.9</range>
        <soundCastTail>GunTail_Light</soundCastTail>
        <soundCast>Dryad_ThornShoot</soundCast>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Dryad_GauBullet']/thingClass</xpath>
    <value>
      <thingClass>CombatExtended.BulletCE</thingClass>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Dryad_GauBullet']/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>RangedStab</damageDef>
        <damageAmountBase>20</damageAmountBase>
        <stoppingPower>2</stoppingPower>
        <speed>35</speed>
        <arcHeightFactor>0.25</arcHeightFactor>
        <shadowSize>0.4</shadowSize>
        <armorPenetrationSharp>4</armorPenetrationSharp>
        <armorPenetrationBlunt>8</armorPenetrationBlunt>
      </projectile>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName='Dryad_GiantThorncaster_Gun']/verbs/li[defaultProjectile='Dryad_GauBulletSpam']</xpath>
