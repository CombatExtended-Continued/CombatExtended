<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Each gun has a second Verb_Shoot for sap. MakeGun would delete both and append one, so these verbs are replaced by hand. -->

	<!-- ========== Thorncaster ========== -->

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Dryad_Thorncaster_Gun"]/statBases/*[self::AccuracyTouch or self::AccuracyShort or self::AccuracyMedium or self::AccuracyLong]</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thorncaster_Gun"]/statBases</xpath>
		<value>
			<SightsEfficiency>0.6</SightsEfficiency>
			<ShotSpread>0.16</ShotSpread>
			<SwayFactor>1.4</SwayFactor>
			<Bulk>6</Bulk>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Dryad_Thorncaster_Gun"]/verbs/li[defaultProjectile="Dryad_GauBullet"]</xpath>
		<value>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Dryad_GauBullet</defaultProjectile>
				<warmupTime>0</warmupTime>
				<range>28.9</range>
				<ticksBetweenBurstShots>35</ticksBetweenBurstShots>
				<burstShotCount>2</burstShotCount>
				<soundCast>Dryad_ThornShoot</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<recoilAmount>1.2</recoilAmount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thorncaster_Gun"]</xpath>
		<value>
			<comps>
				<li Class="CombatExtended.CompProperties_FireModes">
					<aiUseBurstMode>true</aiUseBurstMode>
					<aiAimMode>AimedShot</aiAimMode>
					<aimedBurstShotCount>2</aimedBurstShotCount>
				</li>
			</comps>
		</value>
	</Operation>

	<!-- ========== Impaler ========== -->

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Dryad_Thornlauncher_Gun"]/statBases/*[self::AccuracyTouch or self::AccuracyShort or self::AccuracyMedium or self::AccuracyLong]</xpath>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thornlauncher_Gun"]/statBases</xpath>
		<value>
			<SightsEfficiency>0.7</SightsEfficiency>
			<ShotSpread>0.12</ShotSpread>
			<SwayFactor>1.5</SwayFactor>
			<Bulk>8</Bulk>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Dryad_Thornlauncher_Gun"]/verbs/li[defaultProjectile="Dryad_HeavyGauBullet"]</xpath>
		<value>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Dryad_HeavyGauBullet</defaultProjectile>
				<warmupTime>3</warmupTime>
				<range>22.9</range>
				<minRange>3.9</minRange>
				<ticksBetweenBurstShots>35</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<requireLineOfSight>false</requireLineOfSight>
				<ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
				<soundCast>Dryad_ThornShoot</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<recoilAmount>1.8</recoilAmount>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thornlauncher_Gun"]</xpath>
		<value>
			<comps>
				<li Class="CombatExtended.CompProperties_FireModes">
					<aiAimMode>AimedShot</aiAimMode>
				</li>
			</comps>
		</value>
	</Operation>

