	<!-- Building accuracy is the turret stat CE reads. 0.5 is a mini-turret. 1.0 is a charge blaster. 1.5 is a sniper turret. -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thorncaster"]</xpath>
		<value>
			<statBases>
				<ShootingAccuracyTurret>0.5</ShootingAccuracyTurret>
			</statBases>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_Thornlauncher"]</xpath>
		<value>
			<statBases>
				<ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
			</statBases>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Dryad_GiantThorncaster"]/statBases</xpath>
		<value>
			<ShootingAccuracyTurret>0.5</ShootingAccuracyTurret>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Dryad_SuperThornlauncher"]/statBases/ShootingAccuracyTurret</xpath>
		<value>
			<ShootingAccuracyTurret>1.5</ShootingAccuracyTurret>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Dryad_SuperThornlauncher"]/statBases/RangedWeapon_Cooldown</xpath>
		<value>
			<RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
		</value>
	</Operation>

