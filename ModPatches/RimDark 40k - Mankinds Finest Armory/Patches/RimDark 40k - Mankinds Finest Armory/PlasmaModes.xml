<?xml version='1.0' encoding='utf-8'?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BEWH_Projectile_PlasmaCharged"]/thingClass</xpath>
        <value>
            <thingClass>CombatExtended.BulletCE</thingClass>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BEWH_Projectile_PlasmaCharged"]/projectile</xpath>
        <value>
            <projectile Class="CombatExtended.ProjectilePropertiesCE">
                <damageDef>Bullet</damageDef>
                <damageAmountBase>47</damageAmountBase>
                <armorPenetrationSharp>50</armorPenetrationSharp>
                <armorPenetrationBlunt>6</armorPenetrationBlunt>
                <speed>73</speed>
            </projectile>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_Projectile_PlasmaCharged"]</xpath>
        <value>
            <comps>
                <li Class="CombatExtended.CompProperties_ExplosiveCE">
                    <damageAmountBase>20</damageAmountBase>
                    <explosiveDamageType>Burn</explosiveDamageType>
                    <explosiveRadius>1</explosiveRadius>
                    <explosionSound>MortarBomb_Explode</explosionSound>
                    <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
                </li>
            </comps>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_Projectile_PlasmaCharged"]/modExtensions</xpath>
        <value>
            <li Class="CombatExtended.RimDarkPlasmaModeExtension"/>
        </value>
