<?xml version="1.0" encoding="UTF-8"?>
<Patch>
    <!-- Gun Melee Tools-->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[
        defName = "BEWH_AstartesPlasmaPistol" or
        defName = "BEWH_AstartesBoltPistol" or
        defName = "BEWH_AstartesBoltPistol_Heavy"
        ]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>grip</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>2</power>
                    <cooldownTime>1.54</cooldownTime>
                    <chanceFactor>1.5</chanceFactor>
                    <armorPenetrationBlunt>0.555</armorPenetrationBlunt>
                    <linkedBodyPartsGroup>Grip</linkedBodyPartsGroup>
                </li>
                <li Class="CombatExtended.ToolCE">
                    <label>muzzle</label>
                    <capacities>
                        <li>Poke</li>
                    </capacities>
                    <power>2</power>
                    <cooldownTime>1.54</cooldownTime>
                    <armorPenetrationBlunt>0.555</armorPenetrationBlunt>
                    <linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
                </li>
            </tools>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[
        defName = "BEWH_AstartesBoltCarbine" or 
        defName = "BEWH_AstartesBoltCarbine_Oculus" or
        defName = "BEWH_AstartesBoltRifle_Stalker" or
        defName = "BEWH_AstartesBoltRifle_Heavy" or
        defName = "BEWH_AstartesBoltRifle_Sniper" or
        defName = "BEWH_AstartesPlasmaIncinerator"
        ]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>stock</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>8</power>
                    <cooldownTime>1.55</cooldownTime>
                    <chanceFactor>1.5</chanceFactor>
                    <armorPenetrationBlunt>2.755</armorPenetrationBlunt>
                </li>
                <li Class="CombatExtended.ToolCE">
                    <label>barrel</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>5</power>
                    <cooldownTime>2.02</cooldownTime>
                    <armorPenetrationBlunt>1.630</armorPenetrationBlunt>
                </li>
                <li Class="CombatExtended.ToolCE">
                    <label>muzzle</label>
                    <capacities>
                        <li>Poke</li>
                    </capacities>
                    <power>8</power>
                    <cooldownTime>1.55</cooldownTime>
                    <armorPenetrationBlunt>2.755</armorPenetrationBlunt>
                </li>
            </tools>
        </value>
    </Operation>


    <!-- Bolt Carbine: More compact version of standard Bolter. Less mass/bulk, a bit more sway and recoil, shorter reload time. -->
    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>BEWH_AstartesBoltCarbine</defName>
        <statBases>
            <Mass>5.50</Mass>
            <Bulk>5.50</Bulk>
            <SwayFactor>1.55</SwayFactor>
            <ShotSpread>0.06</ShotSpread>
            <SightsEfficiency>1</SightsEfficiency>
            <RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
        </statBases>
        <AmmoUser>
            <magazineSize>36</magazineSize>
            <reloadTime>3</reloadTime>
            <ammoSet>AmmoSet_Bolter75</ammoSet>
        </AmmoUser>
        <FireModes>
            <aiAimMode>Snapshot</aiAimMode>
            <aiUseBurstMode>True</aiUseBurstMode>
            <aimedBurstShotCount>4</aimedBurstShotCount>
        </FireModes>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BEWH_AstartesBoltCarbine"]/verbs</xpath>
        <value>
            <verbs>
                <li Class="CombatExtended.VerbPropertiesCE">
                    <recoilAmount>0.99</recoilAmount>
                    <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                    <hasStandardCommand>True</hasStandardCommand>
                    <defaultProjectile>Bullet_Bolter75_Standard</defaultProjectile>
                    <warmupTime>1</warmupTime>
                    <range>44</range>
                    <burstShotCount>4</burstShotCount>
                    <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
                    <soundCast>BEWH_SFX_BolterShot</soundCast>
                    <soundCastTail>GunTail_Medium</soundCastTail>
                    <muzzleFlashScale>12</muzzleFlashScale>
                </li>
            </verbs>
        </value>
    </Operation>


