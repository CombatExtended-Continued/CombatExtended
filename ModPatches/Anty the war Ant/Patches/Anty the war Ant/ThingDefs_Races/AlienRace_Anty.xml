<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="AT_PawnBase"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="AT_PawnBase"]</xpath>
			<value>
				<comps />
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="AT_PawnBase"]/comps</xpath>
		<value>
			<li>
				<compClass>CombatExtended.CompPawnGizmo</compClass>
			</li>
			<li Class="CombatExtended.CompProperties_Suppressable" />
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="AT_PawnBase"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_Inventory" />
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Anty"]</xpath>
		<value>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Humanoid</bodyShape>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[
			defName="AT_Lacerator" or
			defName="AT_Oppressor" or
			defName="AT_dreadnought"]</xpath>
		<value>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Serpentine</bodyShape>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Hiveguard"]</xpath>
		<value>
			<li Class="CombatExtended.RacePropertiesExtensionCE">
				<bodyShape>Vehicle</bodyShape>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[
			defName="AT_Lacerator" or
			defName="AT_Oppressor" or
			defName="AT_dreadnought"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>15</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[
			defName="AT_Lacerator" or
			defName="AT_Oppressor" or
			defName="AT_dreadnought"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>7</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Hiveguard"]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>45</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Hiveguard"]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>20</ArmorRating_Sharp>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[
			defName="AT_Hiveguard" or
			defName="AT_Lacerator" or
			defName="AT_Oppressor" or
			defName="AT_dreadnought"]/statBases</xpath>
		<value>
			<MeleeCritChance>1</MeleeCritChance>
			<MeleeParryChance>1</MeleeParryChance>
			<Suppressability>0</Suppressability>
			<SmokeSensitivity>0</SmokeSensitivity>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Anty"]/statBases</xpath>
		<value>
			<MeleeCritChance>1</MeleeCritChance>
			<MeleeParryChance>1</MeleeParryChance>
			<Suppressability>0.5</Suppressability>
			<SmokeSensitivity>0.9</SmokeSensitivity>
		</value>
	</Operation>

	<!--Only bite-->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Anty"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>teeth</label>
					<capacities>
						<li>Bite</li>
					</capacities>
					<power>3</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
					<chanceFactor>1</chanceFactor>
					<armorPenetrationSharp>0.1</armorPenetrationSharp>
					<armorPenetrationBlunt>0.5</armorPenetrationBlunt>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Hiveguard"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>Big jaw</label>
					<capacities>
						<li>Bite</li>
					</capacities>
					<power>10</power>
					<cooldownTime>1</cooldownTime>
					<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
					<chanceFactor>1</chanceFactor>
					<armorPenetrationSharp>10</armorPenetrationSharp>
					<armorPenetrationBlunt>25</armorPenetrationBlunt>
					<extraMeleeDamages>
						<li>
							<def>EMP</def>
							<amount>30</amount>
							<chance>0.15</chance>
						</li>
					</extraMeleeDamages>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_dreadnought"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>Big jaw</label>
					<capacities>
						<li>Bite</li>
					</capacities>
					<power>15</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
					<armorPenetrationSharp>5</armorPenetrationSharp>
					<armorPenetrationBlunt>10</armorPenetrationBlunt>
					<extraMeleeDamages>
						<li>
							<def>Anty_Cut</def>
							<amount>10</amount>
							<chance>0.65</chance>
						</li>
						<li>
							<def>EMP</def>
							<amount>25</amount>
							<chance>0.15</chance>
						</li>
						<li>
							<def>Stun</def>
							<amount>5</amount>
							<chance>0.05</chance>
						</li>
					</extraMeleeDamages>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Lacerator"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>Big jaw</label>
					<capacities>
						<li>Bite</li>
					</capacities>
					<power>15</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
					<armorPenetrationSharp>5</armorPenetrationSharp>
					<armorPenetrationBlunt>10</armorPenetrationBlunt>
					<extraMeleeDamages>
						<li>
							<def>EMP</def>
							<amount>25</amount>
							<chance>0.15</chance>
						</li>
					</extraMeleeDamages>
				</li>
			</tools>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/AlienRace.ThingDef_AlienRace[defName="AT_Oppressor"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>Big jaw</label>
					<capacities>
						<li>Bite</li>
					</capacities>
					<power>15</power>
					<cooldownTime>1.5</cooldownTime>
					<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
					<armorPenetrationSharp>5</armorPenetrationSharp>
					<armorPenetrationBlunt>10</armorPenetrationBlunt>
					<extraMeleeDamages>
						<li>
							<def>EMP</def>
							<amount>30</amount>
							<chance>0.15</chance>
						</li>
					</extraMeleeDamages>
				</li>
			</tools>
		</value>
	</Operation>

</Patch>