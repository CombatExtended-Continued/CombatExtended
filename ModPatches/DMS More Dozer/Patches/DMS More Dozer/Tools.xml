<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Parent tools are invisible to xpath. More Dozer's CE sequence replaces /tools and then adds partial armor. An empty node lets that replace hit. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="DMS_Mech_RocketNest_pirate"]/tools</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="DMS_Mech_RocketNest_pirate"]</xpath>
			<value>
				<tools />
			</value>
		</nomatch>
	</Operation>

