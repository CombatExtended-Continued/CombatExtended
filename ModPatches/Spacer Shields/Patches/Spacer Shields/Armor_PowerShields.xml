<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!--Replace ThingClass-->
	<!--Note LTS_Apparel_Shield_Standard is a banner looking portable shield pack and LTS_Apparel_Shield_SolenoidUnique is Archotech none sense that can't be damaged-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="LTS_Apparel_BasePowerShield" or defName="LTS_Apparel_Shield_SolenoidUnique"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Apparel_Shield</thingClass>
		</value>
	</Operation>

	<!--Replace Parent-->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[@Name="LTS_Apparel_BasePowerShield" or defName="LTS_Apparel_Shield_SolenoidUnique"]</xpath>
		<attribute>ParentName</attribute>
		<value>ArmorSmithableBase</value>
	</Operation>

	<!--Replace Apparel Layer & BodyPart Group -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="LTS_Apparel_BasePowerShield" or defName="LTS_Apparel_Shield_SolenoidUnique"]/apparel/layers</xpath>
		<value>
			<layers>
				<li>Shield</li>
			</layers>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="LTS_Apparel_BasePowerShield" or defName="LTS_Apparel_Shield_SolenoidUnique"]/apparel/bodyPartGroups</xpath>
		<value>
			<bodyPartGroups>
				<li>LeftShoulder</li>
			</bodyPartGroups>
		</value>
	</Operation>

	<!--Replace graphicClass -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Power" or defName="LTS_Apparel_Shield_Energy" or defName="LTS_Apparel_Shield_Solenoid" or defName="LTS_Apparel_Shield_SolenoidUnique"]/graphicData/graphicClass</xpath>
		<value>
			<graphicClass>Graphic_Multi</graphicClass>
		</value>
	</Operation>

	<!--Remove melee tools & VFE Shield comp-->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[@Name="LTS_Apparel_BasePowerShield" or defName="LTS_Apparel_Shield_SolenoidUnique"]/tools</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Power" or defName="LTS_Apparel_Shield_Energy" or defName="LTS_Apparel_Shield_Standard" or defName="LTS_Apparel_Shield_Solenoid" or defName="LTS_Apparel_Shield_SolenoidUnique"]/comps/li[@Class="VEF.Apparels.CompProperties_Shield"]</xpath>
	</Operation>

	<!--Add renderNodeProperties-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Power"]</xpath>
		<value>
			<apparel>
				<renderNodeProperties>
					<li>
						<nodeClass>CombatExtended.PawnRenderNode_Apparel</nodeClass>
						<workerClass>CombatExtended.PawnRenderNodeWorker_Drafted</workerClass>
						<texPath>Things/Apparel/PowerShield/PowerShield</texPath>
						<shaderTypeDef>CutoutComplex</shaderTypeDef>
						<parentTagDef>ApparelBody</parentTagDef>
						<drawData>
							<scale>1</scale>
							<defaultData>
								<layer>80</layer>
							</defaultData>
							<dataEast>
								<layer>-5</layer>
								<offset>(0, 0, -0.1)</offset>
								<rotationOffset>45</rotationOffset>
							</dataEast>
							<dataWest>
								<rotationOffset>-45</rotationOffset>
							</dataWest>
							<dataNorth>
								<layer>-5</layer>
								<offset>(0.15, 0, -0.1)</offset>
							</dataNorth>
							<dataSouth>
								<offset>(0.2, 0, -0.1)</offset>
							</dataSouth>
						</drawData>
					</li>
				</renderNodeProperties>
			</apparel>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Energy"]</xpath>
