			<WornBulk>2</WornBulk>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Solenoid" or defName="LTS_Apparel_Shield_SolenoidUnique"]/statBases</xpath>
		<value>
			<Bulk>4.5</Bulk>
			<WornBulk>3</WornBulk>
		</value>
	</Operation>

	<!--Replace Stat Offsets-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Power" or defName="LTS_Apparel_Shield_Standard"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<ReloadSpeed>-0.2</ReloadSpeed>
				<MeleeHitChance>-4</MeleeHitChance>
				<ShootingAccuracyPawn>-0.25</ShootingAccuracyPawn>
				<AimingAccuracy>-0.2</AimingAccuracy>
				<Suppressability>-0.4</Suppressability>
				<MeleeCritChance>-0.2</MeleeCritChance>
				<MeleeParryChance>1.0</MeleeParryChance>
			</equippedStatOffsets>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="LTS_Apparel_Shield_Energy" or defName="LTS_Apparel_Shield_Solenoid" or defName="LTS_Apparel_Shield_SolenoidUnique"]/equippedStatOffsets</xpath>
		<value>
			<equippedStatOffsets>
				<ReloadSpeed>-0.05</ReloadSpeed>
				<MeleeHitChance>-0.01</MeleeHitChance>
				<ShootingAccuracyPawn>-0.1</ShootingAccuracyPawn>
				<AimingAccuracy>-0.05</AimingAccuracy>
				<Suppressability>-0.20</Suppressability>
				<MeleeCritChance>0.05</MeleeCritChance>
				<MeleeParryChance>0.75</MeleeParryChance>
