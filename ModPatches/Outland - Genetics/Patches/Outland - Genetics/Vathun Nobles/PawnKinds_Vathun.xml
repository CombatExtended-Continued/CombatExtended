<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Outland - Vathun Nobles</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<!-- Footsoldier / Bowman -->
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/PawnKindDef[defName="Outland_VathunFootsoldier" or defName="Outland_VathunBowman"]</xpath>
					<value>
						<li Class="CombatExtended.LoadoutPropertiesExtension">
							<primaryMagazineCount>
								<min>4</min>
								<max>6</max>
							</primaryMagazineCount>
							<sidearms>
								<li>
									<generateChance>0.25</generateChance>
									<sidearmMoney>
										<min>150</min>
										<max>350</max>
									</sidearmMoney>
									<weaponTags>
										<li>VathunLightSharp</li>
									</weaponTags>
								</li>
							</sidearms>
						</li>
					</value>
				</li>

				<!-- Noble -->
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/PawnKindDef[defName="Outland_VathunNoble"]</xpath>
					<value>
						<li Class="CombatExtended.LoadoutPropertiesExtension">
							<primaryMagazineCount>
								<min>4</min>
								<max>6</max>
							</primaryMagazineCount>
							<sidearms>
								<li>
									<generateChance>0.33</generateChance>
									<sidearmMoney>
										<min>150</min>
										<max>350</max>
									</sidearmMoney>
									<weaponTags>
										<li>VathunMeleeDecent</li>
									</weaponTags>
								</li>
							</sidearms>
						</li>
					</value>
				</li>

				<!-- Lord -->
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/PawnKindDef[defName="Outland_VathunLord"]</xpath>
					<value>
						<li Class="CombatExtended.LoadoutPropertiesExtension">
							<primaryMagazineCount>
								<min>4</min>
								<max>6</max>
							</primaryMagazineCount>
							<sidearms>
								<li>
									<generateChance>0.33</generateChance>
									<sidearmMoney>
										<min>150</min>
										<max>350</max>
									</sidearmMoney>
									<weaponTags>
										<li>VathunMeleeDecent</li>
									</weaponTags>
								</li>
							</sidearms>
						</li>
					</value>
				</li>

			</operations>
		</match>
	</Operation>
</Patch>
