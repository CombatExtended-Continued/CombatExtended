<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ========== Clothing ========== -->

	<!-- Vathun Tunic -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunTunic"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>1.5</StuffEffectMultiplierArmor>
			<Bulk>1.5</Bulk>
			<WornBulk>0.5</WornBulk>
		</value>
	</Operation>

	<!-- Vathun Cloak -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunCloak"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>5</StuffEffectMultiplierArmor>
			<Bulk>5</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>

	<!-- Vathun Surcoat -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunSurcoat"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
			<Bulk>5</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>

	<!-- Peasant Cap / Noble Cap -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunCap_Peasant" or defName="Outland_VathunCap_Noble"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>2</StuffEffectMultiplierArmor>
			<Bulk>1</Bulk>
			<WornBulk>0.5</WornBulk>
		</value>
	</Operation>

	<!-- ========== Armor ========== -->

	<!-- Vathun Cuirass / Noble Cuirass -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunCuirass" or defName="Outland_VathunCuirass_Noble"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>2.5</StuffEffectMultiplierArmor>
			<Bulk>40</Bulk>
			<WornBulk>5</WornBulk>
		</value>
	</Operation>

	<!-- Vathun Pauldrons / Noble Pauldrons -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunPauldrons" or defName="Outland_VathunPauldrons_Noble"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>2.5</StuffEffectMultiplierArmor>
			<Bulk>8</Bulk>
			<WornBulk>1.5</WornBulk>
		</value>
	</Operation>

	<!-- Peasant Pauldrons -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunPauldrons_Peasant"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
			<Bulk>5</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>

	<!-- Peasant / Guard / Noble Helmet -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Outland_VathunHelmet_Peasant" or defName="Outland_VathunHelmet_Guard" or defName="Outland_VathunHelmet_Noble"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
			<Bulk>4</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>
</Patch>
