<Patch>
	<!-- === Patch Buildings === -->
	<!-- Remove box refuel fuel comps -->
    <Operation Class="PatchOperationRemove">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_GaussGun"
			]/comps/li[
				@Class = "VanillaGravshipExpanded.CompProperties_BoxRefuel"
			]
		</xpath>
	</Operation>
	
	<!-- Replace world artillery -->
    <Operation Class="PatchOperationAttributeSet">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_GaussGun" or
				defName = "VGE_JavelinPod" or
				defName = "VGE_AnticraftCaster"
			]/comps/li[
				@Class = "VanillaGravshipExpanded.CompProperties_WorldArtillery"
			]
		</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.Compatibility.VGECompat.CompProperties_WorldArtilleryCE</value>
	</Operation>

	<!-- Add OrbitalTurretExtension to guns -->
    <Operation Class="PatchOperationAddModExtension">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_Gun_GaussGun" or
				defName = "VGE_Gun_JavelinPod" or
				defName = "VGE_Gun_AnticraftCaster"
			]
		</xpath>
		<value>
			<li Class="CombatExtended.OrbitalTurretExtension">
                <interLayerPrecisionBonusFactor>20</interLayerPrecisionBonusFactor>
                <isMarkMandatory>false</isMarkMandatory>
				<cannotLaunchThroughRoof>false</cannotLaunchThroughRoof>
            </li>
		</value>
	</Operation>

	<!-- Remove fuel comps -->
    <Operation Class="PatchOperationRemove">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_GaussGun" or
				defName = "VGE_AnticraftCaster"
			]/comps/li[
				@Class = "CompProperties_Refuelable"
			]
		</xpath>
	</Operation>

	<!-- Remove all verbs -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[
			defName = "VGE_Gun_GaussGun" or
			defName = "VGE_Gun_JavelinPod" or
			defName = "VGE_Gun_AnticraftCaster"
			]/verbs</xpath>
	</Operation>

	<!-- === GaussGun === -->

	<Operation Class="PatchOperationReplace">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_GaussGun"
			]/thingClass 
		</xpath>
		<value>
			<thingClass>CombatExtended.Compatibility.VGECompat.Building_GravshipTurretAutoAttackCE</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="VGE_GaussGun"]</xpath>
		<value>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.25</speed>
			</li>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_GaussGun</defName>
		<statBases>
			<RangedWeapon_Cooldown>2.59</RangedWeapon_Cooldown>
			<SightsEfficiency>1.00</SightsEfficiency>
			<ShotSpread>0.03</ShotSpread> <!-- base on 40k baneblade -->
			<SwayFactor>1.0</SwayFactor>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Compatibility.VGECompat.Verb_ShootWithSmokeCE</verbClass>
			<defaultProjectile>VGE_Bullet_GaussGun_CE_HE</defaultProjectile>
			<range>99999</range>
			<minRange>14.9</minRange>
			<burstShotCount>1</burstShotCount>
			<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
			<soundCast>VGE_GravshipHowitzer</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>10</muzzleFlashScale>
			<requireLineOfSight>false</requireLineOfSight>
			<!-- <consumeFuelPerShot>5</consumeFuelPerShot> -->
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<isMortar>false</isMortar>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>

			<hasStandardCommand>true</hasStandardCommand>
			<warmupTime>1.8</warmupTime>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
		<AmmoUser>
			<magazineSize>24</magazineSize>
			<reloadTime>7.8</reloadTime>
			<ammoSet>AmmoSet_155mmHowitzerShell_GaussGun</ammoSet>
		</AmmoUser>
	</Operation>

	<!-- === JavelinPod === -->

	<Operation Class="PatchOperationReplace">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_JavelinPod"
			]/thingClass 
		</xpath>
		<value>
			<thingClass>CombatExtended.Compatibility.VGECompat.Building_JavelinPodCE</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="VGE_JavelinPod"]</xpath>
		<value>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.250</speed>
			</li>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_JavelinPod</defName>
		<statBases>
			<ShootingAccuracyTurret>1.25</ShootingAccuracyTurret>
			<AimingAccuracy>1.0</AimingAccuracy>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Compatibility.VGECompat.Verb_ShootWithVGETargeting</verbClass>
			<defaultProjectile>VGE_Bullet_JavelinPod_CE</defaultProjectile>
			<range>99999</range>
			<minRange>14</minRange>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>15</ticksBetweenBurstShots>
			<soundCast>RocketswarmLauncher_Fire</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>8</muzzleFlashScale>
			<requireLineOfSight>false</requireLineOfSight>
			<consumeFuelPerShot>10</consumeFuelPerShot>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>

			<hasStandardCommand>true</hasStandardCommand>
			<warmupTime>3.6</warmupTime>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
		<AmmoUser>
			<magazineSize>60</magazineSize>
			<reloadTime>6.5</reloadTime>
			<ammoSet>AmmoSet_VGE_Bullet_JavelinPod</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
			<aiUseBurstMode>FALSE</aiUseBurstMode>
		</FireModes>
	</Operation>	

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_Gun_JavelinPod"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>20</li>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>60</li>
				</chargeSpeeds>
			</li>
		</value>
	</Operation>

	<!-- === Anticraft Caster === -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName = "VGE_AnticraftCaster"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Compatibility.VGECompat.Building_AnticraftCasterCE</thingClass>
		</value>
	</Operation>


	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="VGE_AnticraftCaster"]</xpath>
		<value>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.6</speed>
			</li>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_AnticraftCaster</defName>
		<statBases>
			<!-- Based on VEFS Graser Cannon Complex patch -->
			<RangedWeapon_Cooldown>0.56</RangedWeapon_Cooldown>
			<AccuracyTouch>1</AccuracyTouch>
			<AccuracyShort>1</AccuracyShort>
			<AccuracyMedium>1</AccuracyMedium>	
			<AccuracyLong>1</AccuracyLong>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Compatibility.VGECompat.Verb_ShootWithVGETargeting</verbClass>
			<defaultProjectile>VGE_Bullet_AnticraftCaster_CE</defaultProjectile>
			<range>9999</range>
			<minRange>14</minRange>
			<forcedMissRadius>0</forcedMissRadius>
			<canGoWild>true</canGoWild>
			<burstShotCount>20</burstShotCount>
			<ticksBetweenBurstShots>3</ticksBetweenBurstShots>
			<soundCast>Shot_BeamRepeater</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>26</muzzleFlashScale>
			<aimingChargeMote>Mote_BeamRepeater_Charge</aimingChargeMote>
			<aimingChargeMoteOffset>1.5</aimingChargeMoteOffset>
			<requireLineOfSight>false</requireLineOfSight>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>

			<hasStandardCommand>true</hasStandardCommand>
			<warmupTime>3.6</warmupTime>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
	</Operation>		

	<!-- === PointDefenseTurret === -->

	<!-- Using this PR as an example : https://github.com/CombatExtended-Continued/CombatExtended/pull/4470/changes#diff-4de1f8cdac8b3e1b87581e507669ae12582bb153ea24a5923b405f9959c7a1be -->
	<!-- The only differences are -->
	<!--  - the range of fire : VFES=19.9 and VGE=14.9 so I subtracted ~25% of the patch range -->
	<!--  - the shots/s : VFES=12 and VGE=4 -->
	<!--  - interception chance for projectile : VFES=13% and VGE=70% -->
	<!--  - interception chance for cargo pods : VFES=10% and VGE=25% -->
	<!-- To reproduce these enhancements in precision, I boosted the accuracy of the turret,
		 and add a very fast projectile to intercept incoming shell -->
	<!-- (Thanks to turkler and DarkByteZero) -->

	<!-- Remove refuelable property -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/comps/li[@Class="CompProperties_Refuelable"] </xpath>
	</Operation>

	<!-- Replace vanilla thingClass -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/thingClass </xpath>
		<value>
			<thingClass>CombatExtended.Building_CIWS_CE</thingClass>
		</value>
	</Operation>

	<!-- Make turrets taller -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/fillPercent </xpath>
		<value>
			<fillPercent>0.85</fillPercent>
		</value>
	</Operation>

	<!-- This is a CIWS turret with a visible radar module on it. Darkness wouldn't affect it that much, so I gave it above-average night vision -->
	<!-- It can't fire at ground targets either, so -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/statBases </xpath>
		<value>
			<AimingAccuracy>2.5</AimingAccuracy>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/statBases </xpath>
		<value>
			<NightVisionEfficiency>1</NightVisionEfficiency>
		</value>
	</Operation>

	<!-- The Anti-Air Turret is not really a traditional turret and lacks many stat entries, so we have to conditional patch them on if they're not present -->
	<!-- I'm not just doing PatchOperationAdd here in case they ever change how they handle anti-air and add these stats -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/statBases/ShootingAccuracyTurret</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/statBases</xpath>
			<value>
				<ShootingAccuracyTurret/>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/statBases/ShootingAccuracyTurret </xpath>
		<value>
			<ShootingAccuracyTurret>5</ShootingAccuracyTurret>
		</value>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/building/turretBurstCooldownTime</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/building</xpath>
			<value>
				<turretBurstCooldownTime/>
			</value>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/building/turretBurstCooldownTime </xpath>
		<value>
			<turretBurstCooldownTime>0.2</turretBurstCooldownTime>
		</value>
	</Operation>

	<!-- Removing the VE anti-air comp -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/comps/li[@Class="VanillaGravshipExpanded.CompProperties_PointDefence"]</xpath>
	</Operation>

	<!-- PlaceWorker_ShowTurretRadius explodes on turrets with no regular ground verb, so we patch it out -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]/placeWorkers/li[text()="PlaceWorker_ShowTurretRadius"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_PointDefenseTurret"]</xpath>
		<value>
			<specialDisplayRadius>64</specialDisplayRadius>
		</value>
	</Operation>

	<!-- Anti-Air Turret -->
	<!-- The verbs are patched in seperately here, as PatchOperationMakeGunCECompatible does not support adding only CIWS verbs -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_PointDefense</defName>
		<statBases>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.04</SwayFactor>
			<Mass>150.0</Mass>
			<RangedWeapon_Cooldown>0.1</RangedWeapon_Cooldown>
		</statBases>
		<AmmoUser>
			<magazineSize>80</magazineSize>
			<reloadTime>9.2</reloadTime>
			<ammoSet>AmmoSet_145x114mm</ammoSet>
		</AmmoUser>
		<FireModes>
			<noSnapshot>true</noSnapshot>
			<noSingleShot>true</noSingleShot>
		</FireModes>
		<weaponTags>
			<li>TurretGun</li>
		</weaponTags>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_Gun_PointDefense"]/verbs/li[verbClass="Verb_Shoot"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_Gun_PointDefense"]/verbs</xpath>
		<value>
			<li Class="CombatExtended.VerbProperties_CIWSProjectile">
				<verbClass>CombatExtended.VerbCIWSProjectile</verbClass>
				<recoilAmount>0.24</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>VGE_Bullet_145x114mm_FMJ_Fast</defaultProjectile>
				<warmupTime>0.1</warmupTime>
				<range>64</range>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<burstShotCount>4</burstShotCount>
				<soundCast>GunShotA</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>15</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
				<holdFireLabel>HoldCloseInProjectilesFire</holdFireLabel>
				<holdFireDesc>HoldCloseInProjectilesFireDesc</holdFireDesc>
			</li>
			<li Class="CombatExtended.VerbProperties_CIWSSkyfaller">
				<verbClass>CombatExtended.VerbCIWSSkyfaller</verbClass>
				<recoilAmount>0.24</recoilAmount>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_145x114mm_FMJ</defaultProjectile>
				<warmupTime>0.1</warmupTime>
				<range>64</range>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<burstShotCount>4</burstShotCount>
				<soundCast>GunShotA</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>15</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
				<holdFireLabel>HoldCloseInSkyfallersFire</holdFireLabel>
			</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_Gun_PointDefense"]/comps</xpath>
		<value>
			<li>
				<compClass>CombatExtended.CompVerbDisabler</compClass>
			</li>
		</value>
	</Operation>

</Patch>