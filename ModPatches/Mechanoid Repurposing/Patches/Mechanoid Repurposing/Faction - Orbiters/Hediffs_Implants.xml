<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Faction - Orbiters</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>

				<!-- tychfor hulk's vacuumshell -->

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinHulk"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
					<value>
						<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinHulk"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
					<value>
						<ArmorRating_Blunt>1</ArmorRating_Blunt>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinHulk"]/modExtensions/li[@Class="MechanoidRepurposing.DefModExtension_SpaceStatOffsets"]/statOffsets/ArmorRating_Sharp</xpath>
					<value>
						<ArmorRating_Sharp>1</ArmorRating_Sharp>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinHulk"]/modExtensions/li[@Class="MechanoidRepurposing.DefModExtension_SpaceStatOffsets"]/statOffsets/ArmorRating_Blunt</xpath>
					<value>
						<ArmorRating_Blunt>2</ArmorRating_Blunt>
					</value>
				</li>

				<!-- cyborg's husk -->

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinCyborg"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
					<value>
						<ArmorRating_Sharp>2.5</ArmorRating_Sharp>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechSkinCyborg"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
					<value>
						<ArmorRating_Blunt>5</ArmorRating_Blunt>
					</value>
				</li>

				<!-- tychfor enforcer's aim assist -->

				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="MR_MechEarEnforcer"]/modExtensions/li[@Class="MechanoidRepurposing.DefModExtension_SpaceStatOffsets"]/statOffsets/ShootingAccuracyPawn</xpath>
					<value>
						<ShootingAccuracyPawn>0.8</ShootingAccuracyPawn>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>
