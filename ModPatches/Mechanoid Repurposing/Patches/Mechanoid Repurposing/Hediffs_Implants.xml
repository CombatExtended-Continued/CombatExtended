<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- pikeman's lens -->
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="MR_MechEye"]/stages/li/statOffsets/ShootingAccuracyPawn</xpath>
		<value>
			<ShootingAccuracyPawn>0.4</ShootingAccuracyPawn>
		</value>
	</Operation>
	
	<!-- cyclops' sensor -->
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="MR_MechEar"]/stages/li/statOffsets/MeleeDodgeChance</xpath>
		<value>
			<MeleeDodgeChance>0.2</MeleeDodgeChance>
		</value>
	</Operation>
	
	<!-- lifter's leg -->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/HediffDef[defName="MR_MechLegLifter"]/stages/li/statFactors</xpath>
		<value>
			<CarryWeight>1.05</CarryWeight>
		</value>
	</Operation>
		
	<!-- centipede's shell -->
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="MR_MechSkin"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>2</ArmorRating_Sharp>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="MR_MechSkin"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>3</ArmorRating_Blunt>
		</value>
	</Operation>
	
	<!-- centurion's tissue -->
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/HediffDef[defName="MR_MechMuscle"]/stages/li/statOffsets</xpath>
		<value>
			<CarryWeight>10</CarryWeight>
		</value>
	</Operation>
	
</Patch>
