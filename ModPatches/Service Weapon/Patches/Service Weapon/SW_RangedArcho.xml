<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- === Remove modExtensions since CE handles it on ammo  === -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[
			defName ="Artemiish_SWGrip" or
			defName ="Artemiish_SWShatter" or
			defName ="Artemiish_SWSpin" or
			defName ="Artemiish_SWPierce" or
			defName ="Artemiish_SWCharge" or
			defName ="Artemiish_SWSurge"]/modExtensions/li[@Class="ServiceWeaponAthenaStub.DamageModifierExtension"]</xpath>
	</Operation>

	<!-- === Tools === -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name ="BaseServiceWeapon"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>melee</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>2</power>
					<cooldownTime>1.54</cooldownTime>
					<extraMeleeDamages>
						<li>
							<def>Stun</def>
							<amount>15</amount>
						</li>
					</extraMeleeDamages>
					<armorPenetrationBlunt>0.555</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

	<!-- === Grip form (P-6 Pistol) === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWGrip</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>	<!--No change due to you still hold the gun -->
			<ShotSpread>0.10</ShotSpread>	<!--From 0.15 -->
			<SightsEfficiency>1</SightsEfficiency>	<!--From 0.8 -->
			<RangedWeapon_Cooldown>0.38</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.33</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<defaultProjectile>Bullet_SWGrip</defaultProjectile>
			<warmupTime>0.5</warmupTime>
			<range>45</range>	<!--From 16 due to it been the "normal" option and is the rifle equivalent -->
			<soundCast>Shot_Revolver</soundCast>
			<soundCastTail>GunTail_Light</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>20</magazineSize>
			<!--<reloadOneAtATime>true</reloadOneAtATime> No ammoset and round reload to mimic ammo regen doesn't work for relaod time < 0.2 seems -->
			<reloadTime>2</reloadTime>
		</AmmoUser>
		<FireModes>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_OneHandedWeapon</li>
			<li>CE_AI_BROOM</li>
		</weaponTags>
	</Operation>

	<!-- === Shatter form (S-12 charge shotgun) === -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName ="Artemiish_SWShatter"]/modExtensions/li[@Class="AngularShotgunExtension.AngularShotgunExtension"]</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName ="Artemiish_SWShatter"]/verbs/li/verbClass</xpath>
		<value>
			<verbClass>Verb_Shoot</verbClass>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWShatter</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>	<!--all forms are pistol -->
			<ShotSpread>0.10</ShotSpread>	<!--From 0.14 -->
			<SightsEfficiency>1.30</SightsEfficiency> <!--From 1.1 -->
			<RangedWeapon_Cooldown>0.39</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.68</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<defaultProjectile>Bullet_SWShatter</defaultProjectile>
			<warmupTime>0.5</warmupTime>
			<range>20</range>
			<soundCast>Shot_Shotgun</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>8</magazineSize>
			<reloadOneAtATime>true</reloadOneAtATime>
			<reloadTime>0.25</reloadTime>
		</AmmoUser>
		<FireModes>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_OneHandedWeapon</li>
			<li>CE_AI_BROOM</li>
		</weaponTags>
	</Operation>

	<!-- === Spin form (S-6 charge SMG) === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWSpin</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>	<!--all forms are pistol -->
			<ShotSpread>0.10</ShotSpread>
			<SightsEfficiency>1.3</SightsEfficiency> <!--from 1.1 -->
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.39</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<defaultProjectile>Bullet_SWGrip</defaultProjectile>
			<warmupTime>0.5</warmupTime>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
			<range>31</range>
			<soundCast>Shot_Minigun</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>40</magazineSize>
			<reloadTime>2</reloadTime>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_OneHandedWeapon</li>
			<li>CE_AI_BROOM</li>
		</weaponTags>
	</Operation>

	<!-- === Pierce form (A-12 charge anti-materiel rifle) === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWPierce</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>	<!--all forms are pistol -->
			<ShotSpread>0.03</ShotSpread>
			<SightsEfficiency>3.4</SightsEfficiency>	<!--From 3.2 -->
			<RangedWeapon_Cooldown>0.57</RangedWeapon_Cooldown>
			<NightVisionEfficiency_Weapon>0.6</NightVisionEfficiency_Weapon>	<!--From 0.4 -->
		</statBases>
		<Properties>
			<recoilAmount>2.66</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>True</hasStandardCommand>
			<defaultProjectile>Bullet_SWPierce</defaultProjectile>
			<warmupTime>3.8</warmupTime>
			<range>86</range>
			<soundCast>Shot_SniperRifle</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>4</magazineSize>
			<reloadOneAtATime>true</reloadOneAtATime>
			<reloadTime>0.5</reloadTime>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_SR</li><!--No bipod since pistol -->
		</weaponTags>
	</Operation>

	<!-- === Charge form (Milkor MGL) === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWCharge</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>
			<ShotSpread>0.10</ShotSpread>
			<SightsEfficiency>1.3</SightsEfficiency>	<!--From 1.1 -->
			<RangedWeapon_Cooldown>0.39</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.93</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_SWCharge</defaultProjectile>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<warmupTime>1</warmupTime>
			<range>40</range>
			<minRange>5</minRange>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
			<soundCast>ThumpCannon_Fire</soundCast>
			<muzzleFlashScale>14</muzzleFlashScale>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
		</Properties>
		<AmmoUser>
			<magazineSize>6</magazineSize>
			<reloadOneAtATime>true</reloadOneAtATime>
			<reloadTime>0.32</reloadTime>
		</AmmoUser>
		<FireModes>
			<aiUseBurstMode>FALSE</aiUseBurstMode>
			<aiAimMode>SuppressFire</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AOE</li>
		</weaponTags>
	</Operation>

	<!-- === Surge form (Milkor MGL) === -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Artemiish_SWSurge</defName>
		<statBases>
			<Mass>0.5</Mass>
			<Bulk>0.5</Bulk>
			<SwayFactor>0.97</SwayFactor>
			<ShotSpread>0.10</ShotSpread>
			<SightsEfficiency>1.3</SightsEfficiency>	<!--From 1.1 -->
			<RangedWeapon_Cooldown>0.39</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.93</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_SWSurge</defaultProjectile>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<warmupTime>1</warmupTime>
			<range>40</range>
			<minRange>5</minRange>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
			<soundCast>Shot_IncendiaryLauncher</soundCast>
			<muzzleFlashScale>14</muzzleFlashScale>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
		</Properties>
		<AmmoUser>
			<magazineSize>6</magazineSize>
			<reloadOneAtATime>true</reloadOneAtATime>
			<reloadTime>0.32</reloadTime>
		</AmmoUser>
		<FireModes>
			<aiUseBurstMode>FALSE</aiUseBurstMode>
			<aiAimMode>SuppressFire</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AOE</li>
		</weaponTags>
	</Operation>

</Patch>