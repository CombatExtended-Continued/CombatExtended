<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Snailfalo is a direct giant-snail derivative. Apply the existing CE giant-snail
	     treatment when the optional Snailfalo ThingDef is present. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]</xpath>
					<value>
						<li Class="CombatExtended.RacePropertiesExtensionCE">
							<bodyShape>Serpentine</bodyShape>
						</li>
					</value>
				</li>

				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/statBases</xpath>
					<value>
						<MeleeDodgeChance>0.13</MeleeDodgeChance>
						<MeleeCritChance>0.15</MeleeCritChance>
						<MeleeParryChance>0.2</MeleeParryChance>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/statBases/ArmorRating_Blunt</xpath>
					<value>
						<ArmorRating_Blunt>4</ArmorRating_Blunt>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/statBases/ArmorRating_Sharp</xpath>
					<value>
						<ArmorRating_Sharp>12</ArmorRating_Sharp>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/tools</xpath>
					<value>
						<tools>
							<li Class="CombatExtended.ToolCE">
								<label>head</label>
								<capacities>
									<li>Blunt</li>
								</capacities>
								<power>5</power>
								<cooldownTime>1.97</cooldownTime>
								<chanceFactor>0.2</chanceFactor>
								<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
								<armorPenetrationBlunt>1.5</armorPenetrationBlunt>
							</li>
						</tools>
					</value>
				</li>

				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/comps</xpath>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]</xpath>
						<value>
							<comps />
						</value>
					</nomatch>
				</li>

				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="BGM_Snailfalo"]/comps</xpath>
					<value>
						<li Class="CombatExtended.CompProperties_ArmorDurability">
							<Durability>1075</Durability>
							<Regenerates>true</Regenerates>
							<RegenInterval>600</RegenInterval>
							<RegenValue>5</RegenValue>
							<MinArmorPct>0.25</MinArmorPct>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

</Patch>
