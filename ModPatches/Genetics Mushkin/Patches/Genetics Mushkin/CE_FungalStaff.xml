<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- ===== Fungal staff melee tools ===== -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BMT_FungalStaff"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>handle</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>5</power>
					<cooldownTime>1.69</cooldownTime>
					<armorPenetrationBlunt>0.8</armorPenetrationBlunt>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>head</label>
					<labelUsedInLogging>false</labelUsedInLogging>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>6</power>
					<cooldownTime>2.85</cooldownTime>
					<armorPenetrationBlunt>1.69</armorPenetrationBlunt>
				</li>
			</tools>
		</value>
	</Operation>

	<!-- ===== Fungal staff ranged attack ===== -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>BMT_FungalStaff</defName>
		<statBases>
			<Mass>3</Mass>
			<Bulk>4</Bulk>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.8</ShotSpread>
			<SwayFactor>1.5</SwayFactor>
			<RangedWeapon_Cooldown>2.6</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<label>fling spores</label>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>BGM_Proj_ToxSpores_CE</defaultProjectile>
			<range>13</range>
			<warmupTime>1.5</warmupTime>
			<recoilAmount>1</recoilAmount>
			<noiseRadius>4</noiseRadius>
			<ai_IsBuildingDestroyer>false</ai_IsBuildingDestroyer>
			<soundCast>ThrowGrenade</soundCast>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			<ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
		</Properties>
		<FireModes>
			<aiUseBurstMode>false</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_AOE</li>
		</weaponTags>
	</Operation>

</Patch>
