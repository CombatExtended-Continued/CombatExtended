<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="RH_ChitinSkin"]/statOffsets/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>4</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="RH_ChitinSkin"]/statOffsets/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>2</ArmorRating_Blunt>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="RH_HiverSoldierHead_Hediff"]/stages/li/statOffsets/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>3</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/HediffDef[defName="RH_HiverSoldierHead_Hediff"]/stages/li/statOffsets/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>4</ArmorRating_Blunt>
		</value>
	</Operation>

	<!-- Simple helmet is 4. A metallic plate helm sits above that. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RH_DronePlateHelm"]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>6</StuffEffectMultiplierArmor>
			<Bulk>4</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>

	<!-- Vanilla -3.5 would erase a trained shooter's weapon handling. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RH_DronePlateHelm"]/equippedStatOffsets/ShootingAccuracyPawn</xpath>
		<value>
			<ShootingAccuracyPawn>-0.75</ShootingAccuracyPawn>
		</value>
	</Operation>

</Patch>
