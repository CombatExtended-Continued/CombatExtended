<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_PlasmaPetal</defName>
		<label>Crimson petal</label>
		<ammoTypes>
			<Ammo_PlasmaCellHeavy>Bullet_PlasmaPetal</Ammo_PlasmaCellHeavy>
		</ammoTypes>
		<similarTo>AmmoSet_LauncherGrenade</similarTo>
	</CombatExtended.AmmoSetDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>Bullet_Sawblades_Heat</defName>
		<label>Plasma Sawblades</label>
		<graphicData>
			<texPath>Things/Projectile/PlasmaSawProj</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1.3</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>120</speed>
			<spinRate>5</spinRate>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>5</damageAmountBase>
			<explosionRadius>1</explosionRadius>
			<applyDamageToExplosionCellsNeighbors>false</applyDamageToExplosionCellsNeighbors>
			<secondaryDamage>
				<li>
					<def>Flame_Secondary</def>
					<amount>20</amount>
				</li>
			</secondaryDamage>
			<screenShakeFactor>0</screenShakeFactor>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Medium>1</Fragment_Medium>
					<Fragment_Small>3</Fragment_Small>
				</fragments>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>Bullet_PlasmaPetal</defName>
		<label>crimson petal</label>
		<graphicData Class="VEF.Graphics.GraphicData_Animated">
			<texPath>Things/Projectile/PlasmaPetal</texPath>
			<graphicClass>VEF.Graphics.Graphic_Animated</graphicClass>
			<drawSize>0.5</drawSize>
			<ticksPerFrame>2</ticksPerFrame>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bomb</damageDef>
			<damageAmountBase>20</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>Flame_Secondary</def>
					<amount>66</amount>
				</li>
			</secondaryDamage>
			<speed>35</speed>
			<speedGain>20</speedGain>
			<fuelTicks>600</fuelTicks>
			<screenShakeFactor>0</screenShakeFactor>
			<trajectoryWorker>CombatExtended.SmartRocketTrajectoryWorker</trajectoryWorker>
			<preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
		</projectile>
	</ThingDef>
</Defs>
