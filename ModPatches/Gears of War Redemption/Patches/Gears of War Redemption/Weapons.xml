<Patch>

	<!-- Gnasher uses a third-party shotgun verb. Remove it before the CE verb is added. -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Gun_GOW_Gnasher"]/verbs/li[verbClass="Shotgunz.Verb_Shoot_Shotgunz"]</xpath>
	</Operation>

	<!-- ========== MK2 Lancer, 7.62x51, chainsaw ========== -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Gun_GOW_MK2Lancer</defName>
		<statBases>
			<Bulk>10.5</Bulk>
