<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- These defs load only with Big and Small - Framework. Skip quietly otherwise. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/GeneDef[defName="GOW_LocustDrone"]</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="GOW_LocustDrone"]/statOffsets/ArmorRating_Sharp</xpath>
					<value><ArmorRating_Sharp>2</ArmorRating_Sharp></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="GOW_LocustDrone"]/statOffsets/ArmorRating_Blunt</xpath>
					<value><ArmorRating_Blunt>3</ArmorRating_Blunt></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="GOW_LocustBoomer"]/statOffsets/ArmorRating_Sharp</xpath>
					<value><ArmorRating_Sharp>4</ArmorRating_Sharp></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="GOW_LocustBoomer"]/statOffsets/ArmorRating_Blunt</xpath>
					<value><ArmorRating_Blunt>6</ArmorRating_Blunt></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/GeneDef[defName="GOW_LocustKantus"]/statOffsets/ArmorRating_Sharp</xpath>
