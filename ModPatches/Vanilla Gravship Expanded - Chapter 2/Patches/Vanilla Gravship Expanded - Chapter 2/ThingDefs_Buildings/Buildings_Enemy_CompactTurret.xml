<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- === VGE_Turret_DefenderTurret === -->
    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Building_TurretGunCE</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/comps/li[@Class="CompProperties_Stunnable"]/affectedDamageDefs/li[.="Stun"]</xpath>
	</Operation>
	
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/statBases/MaxHitPoints</xpath>
		<value>
			<MaxHitPoints>200</MaxHitPoints>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/fillPercent</xpath>
		<value>
			<fillPercent>0.85</fillPercent>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/statBases</xpath>
		<value>
			<AimingAccuracy>0.25</AimingAccuracy>
			<ShootingAccuracyTurret>0.5</ShootingAccuracyTurret>
			<Mass>20</Mass>
			<Bulk>20</Bulk>
		</value>
	</Operation>

		<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Turret_DefenderTurret"]/building/turretBurstCooldownTime</xpath>
		<value>
			<turretBurstCooldownTime>1.0</turretBurstCooldownTime>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_Gun_DefenderTurret"]/verbs</xpath>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_DefenderTurret</defName>
		<statBases>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.07</ShotSpread>
			<SwayFactor>0.67</SwayFactor>
			<Mass>4</Mass>
		</statBases>
		<Properties>
			<recoilAmount>1.02</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_485x49mm_FMJ</defaultProjectile>
			<warmupTime>0</warmupTime>
			<range>56</range>
			<ticksBetweenBurstShots>22</ticksBetweenBurstShots>
			<burstShotCount>6</burstShotCount>
			<soundCast>GunShotA</soundCast>
			<soundCastTail>GunTail_Light</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
		<AmmoUser>
			<magazineSize>150</magazineSize>
			<reloadTime>7.8</reloadTime>
			<ammoSet>AmmoSet_485x49mm</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
			<noSnapshot>true</noSnapshot>
			<noSingleShot>true</noSingleShot>
		</FireModes>
	</Operation>

