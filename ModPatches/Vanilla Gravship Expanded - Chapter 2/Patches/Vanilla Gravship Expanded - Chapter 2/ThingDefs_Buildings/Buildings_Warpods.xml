<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- We don't exactly have hellpods in real life, so the stats here are roughly half of 155mm directfire shell stats -->
	<!-- That mostly keeps the relative vanilla balance of things -->
    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Warpod_HighExplosive"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
		<value>
            <li Class="CompProperties_Explosive">
				<explosiveDamageType>Bomb</explosiveDamageType>
                <explosiveRadius>5.9</explosiveRadius>
        		<damageAmountBase>275</damageAmountBase>
                <armorPenetrationBase>0.1</armorPenetrationBase>
                <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
                <wickTicks>120~360</wickTicks>
			</li>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Large>30</Fragment_Large>
					<Fragment_Small>60</Fragment_Small>
				</fragments>
			</li>
		</value>
	</Operation>

    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Warpod_EMP"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
		<value>
            <li Class="CompProperties_Explosive">
				<explosiveDamageType>EMP</explosiveDamageType>
                <explosiveRadius>14.9</explosiveRadius>
        		<damageAmountBase>160</damageAmountBase>
                <armorPenetrationBase>0</armorPenetrationBase>
                <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
                <wickTicks>120~360</wickTicks>
			</li>
		</value>
	</Operation>

    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Warpod_Incendiary"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
		<value>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>5.9</explosiveRadius>
                <explosiveDamageType>VGE_AstrofireDamage</explosiveDamageType>
                <damageAmountBase>120</damageAmountBase>
                <armorPenetrationBase>0</armorPenetrationBase>
                <preExplosionSpawnThingDef>VGE_Filth_Astrofuel</preExplosionSpawnThingDef>
                <preExplosionSpawnChance>1</preExplosionSpawnChance>
                <preExplosionSpawnThingCount>4</preExplosionSpawnThingCount>
                <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
                <wickTicks>120~360</wickTicks>
			</li>
		</value>
	</Operation>

    <!-- The antigrain hellpod shares most of its stats with the 81mm antigrain shell because you can't exactly have one and a half grains of antimatter -->
    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName = "VGE_Warpod_Antigrain"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
		<value>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>14.9</explosiveRadius>
                <explosiveDamageType>BombSuper</explosiveDamageType>
                <damageAmountBase>300</damageAmountBase>
                <armorPenetrationBase>1.3</armorPenetrationBase>
                <startWickHitPointsPercent>0.5</startWickHitPointsPercent>
                <wickTicks>360~600</wickTicks>
			</li>
		</value>
	</Operation>

    <!-- For context, the 'base hellpod' carries people but it can explode if damaged. To that end, we're keeping its potential explosion damage pretty modest -->
    <Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_Warpod_Hellpod"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
		<value>
            <li Class="CompProperties_Explosive">
				<explosiveRadius>2.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <damageAmountBase>30</damageAmountBase>
                <armorPenetrationBase>0.1</armorPenetrationBase>
                <startWickHitPointsPercent>0.5</startWickHitPointsPercent>
                <wickTicks>120~360</wickTicks>
			</li>
		</value>
	</Operation>
	
</Patch>