<Patch>
    <!-- === Heavy Artillery === -->

	<!-- Add rotation extension -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[@Name="VGE_EnemyArtilleryBase"]</xpath>
		<value>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.12</speed>
			</li>
		</value>
	</Operation>

	<!-- Replace thingClass -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name = "VGE_EnemyArtilleryBase"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Compatibility.VGECompat.Building_EnemyMechTurretCE</thingClass>
		</value>
	</Operation>

	<!-- Replace world artillery -->
    <Operation Class="PatchOperationAttributeSet">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_EnemyGaussBombard" or
				defName = "VGE_EnemyGaussGun" or
				defName = "VGE_EnemyJavelinPod" or
				defName = "VGE_EnemyAnticraftCaster" or
				defName = "VGE_EnemyAnticraftBeam" or
				defName = "VGE_EnemyGaussCannon" or
				defName = "VGE_EnemyGaussHowitzer" or
				defName = "VGE_EnemyJavelinLauncher"
			]/comps/li[
				@Class = "VanillaGravshipExpanded.CompProperties_WorldArtillery"
			]
		</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.Compatibility.VGECompat.CompProperties_WorldArtilleryCE</value>
	</Operation>

	<!-- Add OrbitalTurretExtension to guns -->
    <Operation Class="PatchOperationAddModExtension">
		<xpath>
			Defs/ThingDef[
				defName = "VGE_Gun_EnemyGaussBombard" or
				defName = "VGE_Gun_EnemyGaussGun" or
				defName = "VGE_Gun_EnemyJavelinPod" or
				defName = "VGE_Gun_EnemyAnticraftCaster" or
				defName = "VGE_Gun_EnemyAnticraftBeam" or
				defName = "VGE_Gun_EnemyGaussCannon" or
				defName = "VGE_Gun_EnemyGaussHowitzer" or
				defName = "VGE_Gun_EnemyJavelinLauncher"
			]
		</xpath>
		<value>
			<li Class="CombatExtended.OrbitalTurretExtension">
                <interLayerPrecisionBonusFactor>20</interLayerPrecisionBonusFactor>
                <isMarkMandatory>false</isMarkMandatory>
				<cannotLaunchThroughRoof>false</cannotLaunchThroughRoof>
            </li>
		</value>
	</Operation>
	
	<!-- Remove all verbs -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[
			defName = "VGE_Gun_EnemyGaussBombard" or
			defName = "VGE_Gun_EnemyGaussGun" or
			defName = "VGE_Gun_EnemyJavelinPod" or
			defName = "VGE_Gun_EnemyAnticraftCaster" or
			defName = "VGE_Gun_EnemyAnticraftBeam" or
			defName = "VGE_Gun_EnemyGaussCannon" or
			defName = "VGE_Gun_EnemyGaussHowitzer" or
			defName = "VGE_Gun_EnemyJavelinLauncher"
			]/verbs</xpath>
	</Operation>

	<!-- VGE_EnemyGaussBombard -->

	<Operation Class="CombatExtended.Compatibility.VGECompat.PatchOperationMakeVGEBarrelsCompatible">
		<turretDefName>VGE_EnemyGaussBombard</turretDefName>
		<turretGunDefName>VGE_Gun_EnemyGaussBombard</turretGunDefName>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>VGE_Gun_EnemyGaussBombard</defName>
		<statBases>
			<RangedWeapon_Cooldown>2.59</RangedWeapon_Cooldown>
			<SightsEfficiency>1.00</SightsEfficiency>
			<ShotSpread>0.03</ShotSpread>
			<SwayFactor>1.0</SwayFactor>
			<AimingAccuracy>0.5</AimingAccuracy>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Compatibility.VGECompat.Verb_ShootWithSmokeCE</verbClass>
			<defaultProjectile>VGE_Bullet_GaussGun_CE_HE</defaultProjectile>
			<range>99999</range>
			<minRange>11.9</minRange>
			<burstShotCount>2</burstShotCount>
			<ticksBetweenBurstShots>18</ticksBetweenBurstShots>
			<soundCast>VGE_GravshipHowitzer</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>14</muzzleFlashScale>
			<requireLineOfSight>false</requireLineOfSight>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<isMortar>true</isMortar>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>

            <circularError>7</circularError>
			<hasStandardCommand>true</hasStandardCommand>
			<warmupTime>1.8</warmupTime>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
		<AmmoUser>
			<magazineSize>24</magazineSize>
			<reloadTime>7.8</reloadTime>
			<ammoSet>AmmoSet_155mmHowitzerShell_GaussGun</ammoSet>
		</AmmoUser>
	</Operation>

