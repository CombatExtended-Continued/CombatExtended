<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- === Wall Armor === -->
	<!-- adjust damageMultipliers dealt by damage defs and add more damage defs -->
    <Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_GravshipArmor"]</xpath>
		<value>
            <damageMultipliers>
                <li>
                    <damageDef>Bomb</damageDef>
                    <multiplier>0.25</multiplier>
                </li>
                <li>
                    <damageDef>Thump</damageDef>
                    <multiplier>0.5</multiplier>
                </li>
                <li>
                    <damageDef>Thermobaric</damageDef>
                    <multiplier>0.33</multiplier>
                </li>
                <li>
                    <damageDef>Bomb_Secondary</damageDef>
                    <multiplier>0.25</multiplier>
                </li>
                <li>
                    <damageDef>Demolish</damageDef>
                    <multiplier>0.5</multiplier>
                </li>
            </damageMultipliers>
		</value>
	</Operation>
</Patch>
