<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BodyPartDef[defName="VGE_FirstWormSegment"]/hitPoints</xpath>
		<value>
			<hitPoints>30</hitPoints>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BodyPartDef[defName="VGE_SecondWormSegment"]/hitPoints</xpath>
		<value>
			<hitPoints>30</hitPoints>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BodyPartDef[defName="VGE_ThirdWormSegment"]/hitPoints</xpath>
		<value>
			<hitPoints>30</hitPoints>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BodyPartDef[defName="VGE_FourthWormSegment"]/hitPoints</xpath>
		<value>
			<hitPoints>30</hitPoints>
		</value>
	</Operation>
	
	<!-- This part is deliberately kept weak because it's not actually one of the worms. The exoworm knot spawns exoworms when any of their worm body parts are destroyed -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/BodyPartDef[defName="VGE_Worm"]/hitPoints</xpath>
		<value>
			<hitPoints>6</hitPoints>
		</value>
	</Operation>
</Patch>