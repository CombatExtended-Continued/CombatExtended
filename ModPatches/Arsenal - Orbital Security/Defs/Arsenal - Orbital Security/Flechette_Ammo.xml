<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<CombatExtended.AmmoCategoryDef>
		<defName>Flechette</defName>
		<label>flechette</label>
		<description>Lethal to organics and almost useless against non-organics, such as mechanoids.</description>
	</CombatExtended.AmmoCategoryDef>

	<ThingCategoryDef>
		<defName>AmmoFlechette</defName>
		<label>Flechette</label>
		<parent>AmmoPistols</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberPistol</iconPath>
	</ThingCategoryDef>

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_Flechette</defName>
		<label>Flechette</label>
		<ammoTypes>
			<Ammo_Flechette>Bullet_Flechette</Ammo_Flechette>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12x64mmChargedBase">
		<description>Fin-stabilized flechettes. Lethal to organics and almost useless against non-organics.</description>
		<defName>Ammo_Flechette</defName>
		<label>Flechette cartridge</label>
		<thingCategories>
			<li>AmmoFlechette</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Ammo/Pistol/AP</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>Flechette</ammoClass>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>Bullet_Flechette</defName>
		<label>flechette</label>
		<graphicData>
			<texPath>Things/Projectile/Bullet_Flechette</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>6</damageAmountBase>
			<speed>100</speed>
			<damageDef>Bullet</damageDef>
			<armorPenetrationSharp>8</armorPenetrationSharp>
			<armorPenetrationBlunt>4</armorPenetrationBlunt>
		</projectile>
	</ThingDef>

	<RecipeDef ParentName="ChargeAmmoRecipeBase">
		<defName>MakeAmmo_Flechette</defName>
		<label>make flechette cartridge x50</label>
		<description>Craft 50 flechette cartridges.</description>
		<jobString>Making flechette cartridges.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_Flechette>500</Ammo_Flechette>
		</products>
		<workAmount>1600</workAmount>
	</RecipeDef>

</Defs>