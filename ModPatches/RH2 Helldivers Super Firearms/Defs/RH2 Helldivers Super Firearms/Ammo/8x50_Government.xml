<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingCategoryDef>
		<defName>Ammo8x50mmGovernment</defName>
		<label>8x50mm Government</label>
		<parent>AmmoRifles</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRifle</iconPath>
	</ThingCategoryDef>

	<!-- ==================== AmmoSet ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_8x50mmGovernment</defName>
		<label>8x50mm Government</label>
		<ammoTypes>
			<Ammo_8x50mmGovernment_FMJ>Bullet_8x50mmGovernment_FMJ</Ammo_8x50mmGovernment_FMJ>
			<Ammo_8x50mmGovernment_AP>Bullet_8x50mmGovernment_AP</Ammo_8x50mmGovernment_AP>
			<Ammo_8x50mmGovernment_HP>Bullet_8x50mmGovernment_HP</Ammo_8x50mmGovernment_HP>
			<Ammo_8x50mmGovernment_Incendiary>Bullet_8x50mmGovernment_Incendiary</Ammo_8x50mmGovernment_Incendiary>
			<Ammo_8x50mmGovernment_HE>Bullet_8x50mmGovernment_HE</Ammo_8x50mmGovernment_HE>
			<Ammo_8x50mmGovernment_Sabot>Bullet_8x50mmGovernment_Sabot</Ammo_8x50mmGovernment_Sabot>
		</ammoTypes>
		<similarTo>AmmoSet_Rifle</similarTo>
	</CombatExtended.AmmoSetDef>

	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="8x50mmGovernmentBase" ParentName="SmallAmmoBase" Abstract="True">
		<description>Large caliber brass-cased rifle bullet based on an ancient pattern. Used exclusively by the R-6 Deadeye levergun.</description>
		<statBases>
			<Mass>0.04</Mass>
			<Bulk>0.02</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting</li>
		</tradeTags>
		<thingCategories>
			<li>Ammo8x50mmGovernment</li>
		</thingCategories>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="8x50mmGovernmentBase">
		<defName>Ammo_8x50mmGovernment_FMJ</defName>
		<label>8x50mm Government (FMJ)</label>
		<graphicData>
			<texPath>Things/Ammo/Rifle/Clip/FMJ</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>FullMetalJacket</ammoClass>
		<cookOffProjectile>Bullet_8x50mmGovernment_FMJ</cookOffProjectile>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="8x50mmGovernmentBase">
		<defName>Ammo_8x50mmGovernment_AP</defName>
