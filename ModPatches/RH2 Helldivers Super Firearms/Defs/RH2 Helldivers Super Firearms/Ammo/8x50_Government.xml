	<!-- ==================== Recipes ========================== -->

	<RecipeDef ParentName="AmmoRecipeBase">
		<defName>MakeAmmo_8x50mmGovernment_FMJ</defName>
		<label>make 8x50mm Government (FMJ) cartridge x500</label>
		<description>Craft 500 8x50mm Government (FMJ) cartridges.</description>
		<jobString>Making 8x50mm Government (FMJ) cartridges.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>40</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_8x50mmGovernment_FMJ>500</Ammo_8x50mmGovernment_FMJ>
		</products>
		<workAmount>4000</workAmount>
	</RecipeDef>

