    <researchPrerequisite>AOC_Toy2_Access</researchPrerequisite>
    <workAmount>300</workAmount>
    <recipeUsers>
      <li>AOC_printer</li>
    </recipeUsers>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>8</count></li>
      <li><filter><thingDefs><li>FSX</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>Steel</li><li>FSX</li><li>ComponentIndustrial</li></thingDefs>
