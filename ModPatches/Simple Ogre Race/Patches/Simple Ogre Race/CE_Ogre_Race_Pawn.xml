<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- Tribal -->
	<Operation Class="CombatExtended.PatchOperationSettingsConditional">
		<settingName>vanillaCombatPower</settingName>
		<nomatch Class="PatchOperationReplace">
			<xpath>Defs/PawnKindDef[defName="FP_OGRE_Tribal_Berserker"]/combatPower</xpath>
			<value>
				<combatPower>60</combatPower>
			</value>
		</nomatch>
	</Operation>

	<!-- Pirate -->
	<Operation Class="CombatExtended.PatchOperationSettingsConditional">
		<settingName>vanillaCombatPower</settingName>
		<nomatch Class="PatchOperationReplace">
			<xpath>Defs/PawnKindDef[defName="FP_OGRE_Pirate_Berserker"]/combatPower</xpath>
			<value>
				<combatPower>120</combatPower>
			</value>
		</nomatch>
	</Operation>
</Patch>